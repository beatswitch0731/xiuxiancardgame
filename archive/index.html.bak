      {
        "id": "shop_npc_favor",
        
        "sceneImage":"assets/cards/events/scene_pool_auction.png",
        "name": "灵石打点",
        "type": "npc_favor",
        "price": 30,
        "realm": "qi",
        "desc": "花灵石疏通关系，提升势力声望或NPC好感。",
        "effect": {
          "npcFavor": 15
        }
      }
    ]
  },
  "cards:story_dialogue": {
    "_desc": "叙事对话卡组 — NPC对话驱动的情节卡，弥补境界池的叙事真空。每张卡带完整角色对白、两个道德/情感选择、挂接弧线推进标签。",
    "_note": "通过CardSystem._loadExtraModule加载，realm字段决定出现在哪个境界的抽卡池中",
    "cards": [
      {
        "id": "sd_qi_bai_ren_first""type": "STORY",
        "title": "师与徒",
        "description": "白刃真人站在你面前——不是教剑，是问话。'你三天跪在山门前——膝盖的血把石阶染了三层。为什么？'他没有等你回答。'不要说是为修仙——那种话我听过几百遍了。'",
        "realm": "qi",
        "weight": 8,
        "once": true,
        "path": "sword",
        "npcId": "bai_ren",
        "tags": [
          "mentor",
          "story",
          "discovery"
        ],
        "choices": {
          "left": {
            "text": "'我没有别的地方可去'",
            "effects": {
              "daoHeart": 15,
              "cultivation": 3,
              "fortune": 5
            },
            "desc": "白刃真人沉默了很久。然后他做了件你从没见他对别的弟子做过的事——他把手放在你头上。'以后——这里就是你的家。'"
          },
          "right": {
            "text": "'我想变强——强到没有人能随便决定我的命运'",
            "effects": {
              "daoHeart": 10,
              "cultivation": 8,
              "karmaBad": 3
            },
            "desc": "白刃真人看着你的眼睛——他的眼神不是赞许，是确认。'好。但记住——变强不是为了不被欺负，是为了有资格保护别人。'"
          }
        }},
      {
        "id": "sd_qi_sword_tomb_whisper""type": "STORY",
        "title": "剑冢低语",
        "description": "深夜——你一个人摸到了剑冢入口。不是白刃真人叫你来的。是你怀里那块碎玉在发热——它在找你，或者你在找它。剑冢深处有什么东西在低语——不是人声，是金属在石头上划过的声音。",
        "realm": "qi",
        "weight": 7,
        "once": true,
        "npcId": "bai_ren",
        "tags": [
          "secret",
          "lore",
          "sword_way",
          "discovery"
        ],
        "choiceType": "RISK",
        "choices": {
          "left": {
            "text": "走进去——不管那声音是什么",
            "effects": {
              "cultivation": 15,
              "daoHeart": 10,
              "health": -10,
              "fortune": 5
            },
            "desc": "你看到了一柄剑——不是插在石壁上的，是浮在空中的。剑身上有一道裂纹——裂纹里透出的光不是灵光，是某种在'看'着你的东西。碎玉在你怀里剧烈震动。它认识这柄剑——或者说，怕它。"
          },
          "right": {
            "text": "退出来——'不是时候'",
            "effects": {
              "daoHeart": 8,
              "fortune": 10,
              "karmaGood": 5
            },
            "desc": "你退出了剑冢。碎玉的温度慢慢降了下来。但你心里知道——总有一天你要回来。那柄剑在等你。"
          }
        },
        "sceneImage": "assets/cards/events/scene_event_qi_swordtomb.png"
      },
      {
        "id": "sd_qi_white_fox""type": "STORY",
        "title": "山中有狐",
        "description": "你在后山采药时发现一只受伤的白狐——它的后腿被捕兽夹夹伤了，雪白的毛上沾着血。它不跑——琥珀色的眼睛看着你，像在等一个答案。'你是妖——'你蹲下来。白狐的耳朵抖了抖——它在听。",
        "realm": "qi",
        "weight": 8,
        "once": true,
        "npcId": "bai_luoxuan",
        "tags": [
          "kindness",
          "discovery",
          "story"
        ],
        "choices": {
          "left": {
            "text": "帮它解开捕兽夹——包扎伤口",
            "effects": {
              "karmaGood": 15,
              "daoHeart": 10,
              "fortune": 5,
              "health": -5
            },
            "cardEffect": "bai_luoxuan_met",
            "desc": "白狐没有挣扎——它让你的手在它腿上折腾了半个时辰。包扎完的时候，它舔了舔你的手指。不是感谢——你后来才知道，白狐舔手指是'我欠你的'的意思。第二天早上，一碗热参汤放在你的洞府门口。"
          },
          "right": {
            "text": "走开——'妖的事与我无关'",
            "effects": {
              "daoHeart": -3,
              "karmaBad": 5
            },
            "desc": "白狐没有叫。它只是看着你走远——琥珀色的眼睛在你背后，盯了很远很远。后来你会知道——白狐的记忆可以传三百年。这一眼，它记了三百年。"
          }
        }},
      {
        "id": "sd_qi_meditation_voice""type": "STORY",
        "title": "打坐时的声音",
        "description": "你第一次尝试入定——别人说入定是'灵台清明'，但你的灵台不空。丹田里三片残根碎片在微微震动，像三块拼图在找彼此的位置。然后——你听到了一个声音。不是耳朵听到的——是识海深处传来的。'别怕——我在。'",
        "realm": "qi",
        "weight": 7,
        "once": true,
        "tags": [
          "hidden",
          "truth",
          "self"
        ],
        "choiceType": "INNER",
        "choices": {
          "left": {
            "text": "'你是谁？'——追问那个声音",
            "effects": {
              "daoHeart": 12,
              "cultivation": 5,
              "fortune": 3
            },
            "desc": "没有回答。但三片残根的震动频率变了——它们开始缓慢地旋转，像一个不完整的漩涡。你有一种奇怪的感觉——那个声音不是别人，是你自己。是'完整的你'在隔着时间对你说话。"
          },
          "right": {
            "text": "忽略它——专注入定",
            "effects": {
              "cultivation": 15,
              "daoHeart": 5
            },
            "desc": "你压下了那个声音。三片残根安静下来——但你没有注意到，它们之间的距离近了一丝。不是入定做到的——是那个声音。"
          }
        },
        "sceneImage": "assets/cards/events/scene_event_qi_meditation.png"
      },
      {
        "id": "sd_fd_bai_luo_soup""type": "STORY",
        "title": "白衣银发",
        "description": "一个白衣银发的女子站在你的洞府门口——傍晚的光从背后透过她的发丝。她端着一碗参汤。'恩公——参汤要趁热喝。'你接过碗。碗是温的——她的手是烫的。'以后别叫我恩公了。'你说。她想了想：'那叫什么？'",
        "realm": "foundation",
        "weight": 8,
        "once": true,
        "npcId": "bai_luoxuan",
        "tags": [
          "companion",
          "kindness",
          "story"
        ],
        "choices": {
          "left": {
            "text": "'叫我名字就好——凌云'",
            "effects": {
              "daoHeart": 10,
              "karmaGood": 8,
              "fortune": 5
            },
            "desc": "'凌云——'她重复了一遍，像在品一个陌生的字。然后她笑了——很浅，但琥珀色的眼睛亮了一下。'好。凌云。明天的参汤也是这个时候。'"
          },
          "right": {
            "text": "'随便——你自己想'",
            "effects": {
              "daoHeart": 5,
              "karmaGood": 5
            },
            "desc": "她歪了歪头——你后来才知道这是白狐在想事情时的习惯。'那就——道侣？'她说得很认真，认真到你不确定她是不是在开玩笑。"
          }
        }},
      {
        "id": "sd_fd_jian_linger_three""type": "STORY",
        "title": "三招之内",
        "description": "剑灵儿抱着剑靠在剑冢石壁上——眼神从上扫到下把你打量了一遍。'你就是师尊新收的弟子？看起来——一般。'她把剑从怀里抽出来——剑尖指向你。'来。拔剑。三招之内你还能站着——就算我认你这个师弟。'她的眼神很冷——但她的剑尖比平时低了三分。",
        "realm": "foundation",
        "weight": 8,
        "once": true,
        "path": "sword",
        "npcId": "jian_linger",
        "tags": [
          "disciple",
          "sword_way",
          "companion",
          "story"
        ],
        "choices": {
          "left": {
            "text": "拔剑应战——'请师姐指教'",
            "effects": {
              "cultivation": 12,
              "daoHeart": 8,
              "health": -10
            },
            "desc": "第一招——她的剑快得像一条银线。你挡住了。第二招——银线变成了网。你的剑被震得脱手——但你还站着。第三招——她的剑尖在你眉心前三寸停下了。她的眼神变了——不是冷，是确认。'行——你是我师弟了。'"
          },
          "right": {
            "text": "'我不想伤到师姐'",
            "effects": {
              "daoHeart": 10
            },
            "desc": "她愣了愣——然后嗤了一声。'伤到我？你先把自己的剑拿稳再说。'但她把剑收回了鞘里。没有出第三招——不是看不起你，是怕你真的伤到。"
          }
        },
        "sceneImage": "assets/cards/events/scene_gd_g_swordIntent.png"
      },
      {
        "id": "sd_fd_sect_rumor""type": "STORY",
        "title": "食堂闲话",
        "description": "食堂里，几个内门弟子在低声议论——'听说掌门当年有个师弟——不是死了，是……叛出去了。''闭嘴——这事谁敢提？'他们看到你走近，立刻噤声。但你听清了——'叛出去'。白刃真人有过一个师弟。",
        "realm": "foundation",
        "weight": 6,
        "tags": [
          "secret",
          "lore",
          "sect"
        ],
        "choices": {
          "left": {
            "text": "假装没听到——但记在心里",
            "effects": {
              "daoHeart": 5,
              "fortune": 3
            },
            "desc": "你端着饭盒走开——但'叛出去'三个字像一根刺扎在你的识海里。白刃真人从来不说过去。他在隐藏什么？还是——在保护谁？"
          },
          "right": {
            "text": "直接问——'掌门的师弟是谁？'",
            "effects": {
              "daoHeart": 8,
              "fortune": -5
            },
            "desc": "几个弟子面面相觑——然后各自散了。但其中一个临走前塞给你一张纸条：'剑冢最深处——有答案。别跟人说是我说的。'"
          }
        }},
      {
        "id": "sd_fd_night_training""type": "STORY",
        "title": "寅时的剑",
        "description": "寅时——天还没亮，你一个人在后山练剑。然后你发现你不是一个人。剑灵儿在二十步外——她的剑路慢到你能看清每一式。不是因为状态不好——是她在教。她没有看你，没有说一个字——但她出剑的节奏刚好够你跟着学。",
        "realm": "foundation",
        "weight": 6,
        "path": "sword",
        "npcId": "jian_linger",
        "tags": [
          "disciple",
          "sword_way",
          "companion"
        ],
        "choices": {
          "left": {
            "text": "'师姐——你是在教我？'",
            "effects": {
              "cultivation": 15,
              "daoHeart": 8
            },
            "desc": "她的剑顿了一下——然后继续挥。'别多想——我只是睡不着。'但她的耳朵红了。寅时的天色还暗——你看不见，但你知道。"
          },
          "right": {
            "text": "默默模仿她的剑路——不说话",
            "effects": {
              "cultivation": 12,
              "daoHeart": 10
            },
            "desc": "你们练到天亮。她收剑的时候看了你一眼——不是夸奖，是计算你进步了多少。'明天这个时辰——再来。别迟到。'"
          }
        },
        "sceneImage": "assets/cards/events/scene_event_qi_swordtomb.png"
      },
      {
        "id": "sd_gd_yin_xue_meet""type": "STORY",
        "title": "枯树下的魔修",
        "description": "殷血靠在枯树上——剑尖在石头上划出三道血槽。'你就是那个青云弟子？听说你最近挺能打。不过——正道教的那些花里胡哨的剑法——拿来杀鸡还行。'她把剑从石头上拔出来。石头上留下三道深深的划痕。'来。三招。我倒要看看——你值不值得我记住名字。'",
        "realm": "golden",
        "weight": 7,
        "once": true,
        "npcId": "yin_xue",
        "tags": [
          "battle",
          "demonic",
          "companion",
          "story"
        ],
        "choices": {
          "left": {
            "text": "拔剑——'我的剑不会让你失望'",
            "effects": {
              "cultivation": 15,
              "daoHeart": 10,
              "health": -15
            },
            "desc": "三招过后——你的剑断了一截。她的剑还在手里——但她的手在微微发抖。不是因为受伤——是因为她笑了。'有意思——你比那些假正经的有意思。记住——我叫殷血。下次见面——不一定比剑。'"
          },
          "right": {
            "text": "'我今天不想打'",
            "effects": {
              "daoHeart": 8,
              "karmaGood": 5
            },
            "desc": "她把剑插回石头上——'没种。'但她没有走。而是靠在树上看着你——像在等一个解释。'正道弟子见了我不是跑就是打——你是第一个说'不想打'的。'她顿了顿。'有点意思。下次——我请你喝酒。'"
          }
        }},
      {
        "id": "sd_gd_sect_pressure""type": "STORY",
        "title": "执事会的目光",
        "description": "执事长老把你叫到了侧殿——不是表扬，是警告。'你最近——接触的魔修有点多。'他把一份名单推到你面前——上面记着你见过的每一个魔修。'宗门不禁止历练，但有些线——踩了就回不来了。'他的眼神在说：有人在看着你。",
        "realm": "golden",
        "weight": 6,
        "tags": [
          "sect",
          "demonic",
          "conflict",
          "story"
        ],
        "choices": {
          "left": {
            "text": "'我知道自己在做什么——正魔之间不只有一种答案'",
            "effects": {
              "daoHeart": 15,
              "fortune": -10,
              "karmaGood": 5
            },
            "desc": "执事长老沉默了——不是因为被说服，是因为你的态度让他想起了另一个人。'掌门当年也这么跟执事会说——后来他的师弟成了血煞老祖。你会走同一条路吗？'"
          },
          "right": {
            "text": "'我会注意的——谢谢长老提醒'",
            "effects": {
              "daoHeart": 5,
              "fortune": 10,
              "karmaGood": 8
            },
            "desc": "他点点头——但你知道这不是信任，是监视。他给了你一条绳子——现在看你怎么走。"
          }
        },
        "sceneImage": "assets/cards/events/scene_fd_f_trial.png"
      },
      {
        "id": "sd_gd_mu_qing_library""type": "STORY",
        "title": "万卷楼的姑娘",
        "description": "万卷楼最深处的灯还亮着——不是你的灯，是她的。慕青岚从古籍后面探出头——鼻尖上沾了一点灰。'你要找什么书？等一下——万卷楼的书都是我管的。你先说你要找什么——我可以告诉你它在哪里，或者直接告诉你它里面写的是什么。'她说话语速很快——不是不耐烦，是怕你嫌她啰嗦。",
        "realm": "golden",
        "weight": 6,
        "once": true,
        "npcId": "mu_qinglan",
        "tags": [
          "secret",
          "lore",
          "companion",
          "story"
        ],
        "choices": {
          "left": {
            "text": "'我需要《通玄真经》第七卷'",
            "effects": {
              "cultivation": 10,
              "daoHeart": 5
            },
            "desc": "'第七卷——第三排，左数第十二本。不过——'她犹豫了一下——'那上面的注解是我写的。不要笑。'她没有问你为什么需要第七卷——她只是把你带到了书架前，然后假装整理旁边的书——其实在等你问她问题。"
          },
          "right": {
            "text": "'你先说说万卷楼最奇怪的书是什么'",
            "effects": {
              "daoHeart": 12,
              "fortune": 8
            },
            "desc": "她眼睛亮了——然后拉着你到了最深处的暗格。'这本书——没有名字，也没有内容。不是没写——是被删掉了。从因果层面抹去的。'她看着你的眼睛——不是在炫耀，是在寻求一个能分担恐惧的人。"
          }
        }},
      {
        "id": "sd_gd_dao_heart_test""type": "STORY",
        "title": "道心之问",
        "description": "天机阁的观星台上——天机老人第一次对你开口。'你来了——不，应该说，你终于来了。'他手中的天机盘碎片转了转——指向你。'老夫等了你很久——不是预知，是因果。不过今天老夫只给你三个问题——第一个，你自己想。'",
        "realm": "golden",
        "weight": 7,
        "once": true,
        "npcId": "tian_ji",
        "tags": [
          "prophecy",
          "truth",
          "seer",
          "story"
        ],
        "choices": {
          "left": {
            "text": "'第一个问题——我是谁？'",
            "effects": {
              "daoHeart": 15,
              "fortune": 10,
              "cultivation": 5
            },
            "desc": "天机老人笑了——一个看过太多的人的笑。'你的灵根是碎的——不是缺陷，是钥匙。你不是修仙者——你是'破坏者'。天道不知道该怎么下你这颗棋子——因为你不在棋盘上。'"
          },
          "right": {
            "text": "'我想问——天道是什么？'",
            "effects": {
              "daoHeart": 12,
              "fortune": 10,
              "karmaGood": 8
            },
            "desc": "天机老人沉默了——然后叹了口气。'天道不是法则——是牢笼。但这个答案你现在承受不了。我答应你——等你金丹圆满时，我再告诉你。'"
          }
        },
        "sceneImage": "assets/cards/events/scene_dt_d_star_gazing.png"
      },
      {
        "id": "sd_gd_broken_jade_glow""type": "STORY",
        "title": "碎玉初鸣",
        "description": "金丹成型的那一刻——你怀里的碎玉第一次发光了。不是在剑冢里那种暗哑的光——是刺目的、完整的、像一颗星星在你胸口炸开的光。周围的空气在震动——不是灵气，是混沌。你的三片残根碎片——第一次同时震动。它们在同频共振——在呼唤什么。",
        "realm": "golden",
        "weight": 5,
        "once": true,
        "tags": [
          "truth",
          "hidden",
          "self",
          "story"
        ],
        "choices": {
          "left": {
            "text": "握住碎玉——回应它的呼唤",
            "effects": {
              "cultivation": 20,
              "daoHeart": 15,
              "fortune": -10,
              "health": -10
            },
            "desc": "一瞬间——你'看到'了。不是用眼睛——是用碎玉。你看到了混沌虚空——天道法则在其中像蛛网一样密布。而你的三脉残根——是三根可以穿过蛛网的针。你不是漏网之鱼——你是故意被放在网外的人。"
          },
          "right": {
            "text": "压制碎玉——'不是时候'",
            "effects": {
              "daoHeart": 10,
              "fortune": 15,
              "karmaGood": 5
            },
            "desc": "碎玉的光慢慢暗了下去。但你知道——它只是暂时睡着了。下一次它亮起来的时候——你可能就压不住了。"
          }
        }},
      {
        "id": "sd_gd_old_friend""type": "STORY",
        "title": "柳河村的信",
        "description": "一封信送到你的洞府——信封上歪歪扭扭写着'凌云收'。不是修士的字——是铁匠的字。你养父不识字——但他学会了写你的名字。信里只有一句话：'活着。'不是'回来看看'，不是'想你了'——是'活着'。这是他临终前对你说的最后两个字。",
        "realm": "golden",
        "weight": 5,
        "once": true,
        "tags": [
          "mortal",
          "family",
          "self",
          "story"
        ],
        "choiceType": "EMOTIONAL",
        "choices": {
          "left": {
            "text": "立刻回柳河村——不管身上有什么伤",
            "effects": {
              "daoHeart": 20,
              "karmaGood": 15,
              "cultivation": -10,
              "fortune": -5
            },
            "desc": "你赶了三百里路——到的时候你养父刚下葬。村里人说：'他每天去河边看你小时候玩的地方——他说你肯定会回来。'你在他坟前跪了一夜。不是哭——是答应。答应他——活着。"
          },
          "right": {
            "text": "把信折好放在枕下——'等我金丹圆满就回去'",
            "effects": {
              "daoHeart": 10,
              "cultivation": 10
            },
            "desc": "你告诉自己：再等一等。但你知道——修仙者的一等，有时候就是一辈子。信纸压在枕下——每天晚上你都能感觉到它在发热。不是灵力——是铁匠的手温。"
          }
        },
        "sceneImage": "assets/cards/events/scene_gd_g_oldFriend.png"
      },
      {
        "id": "sd_nd_jiuwei_moon""type": "STORY",
        "title": "月湖边的九尾",
        "description": "月湖边——她从月色中走出来。九条白色的尾巴如瀑布般散落在身后——不是炫耀，是天狐的本相。'就是你——救了落霜？'她眯着眼——琥珀色的瞳孔在月光下变成了竖瞳。'白狐部欠你的——我还。不过你的修为——实在太差了。跟我来——三千年的东西——够你学了。'",
        "realm": "nascent",
        "weight": 7,
        "once": true,
        "npcId": "jiuwei_suyue",
        "tags": [
          "companion",
          "lore",
          "ancient",
          "story"
        ],
        "choices": {
          "left": {
            "text": "跟上——'请前辈指教'",
            "effects": {
              "cultivation": 15,
              "daoHeart": 8,
              "fortune": 8
            },
            "desc": "她转身——九尾在身后一甩——不是示威，是指路。月华在她身后铺成一条银色的路——不是法术，是天狐血脉在月光下的自然投影。你跟了上去。"
          },
          "right": {
            "text": "'我的路我自己走'",
            "effects": {
              "daoHeart": 15,
              "fortune": 5
            },
            "desc": "她回头——嘴角有一丝意外的笑意。'有意思——三千年了，第一次有人拒绝天狐的指点。'她收了九尾——但没有走。'那你走你的——我在前面等你。三千年我都等了——不差这点时间。'"
          }
        }},
      {
        "id": "sd_nd_xue_sha_trial""type": "STORY",
        "title": "血煞老祖的测试",
        "description": "血煞宗大殿——血煞老祖坐在血玉椅上，闭目养神。但你知道他没睡着——他手里握着剑。'白刃的弟子——'他睁开眼睛——一双血红色的瞳孔锁定了你。'不过——你的剑气里有一点东西我见过。不是白刃教的——是你自己的。'他站起身——比你高出两个头。'有点意思——所以今天不杀你。但明天——不一定。'",
        "realm": "nascent",
        "weight": 7,
        "once": true,
        "npcId": "xue_sha",
        "tags": [
          "demonic",
          "ally",
          "battle",
          "story"
        ],
        "choices": {
          "left": {
            "text": "'我不是来求你不杀的——我是来问你的'",
            "effects": {
              "daoHeart": 15,
              "fortune": 5,
              "karmaGood": 8
            },
            "desc": "他停下——血红色的瞳孔里闪过了一丝意外。'问什么？''你叛出青云——是真的背叛，还是被冤枉的？'他笑了——笑声在大殿里回荡。'好小子——你是第一个敢当面问我这个的正道弟子。坐下来——我今天不杀人了。'"
          },
          "right": {
            "text": "沉默——但握紧了剑",
            "effects": {
              "daoHeart": 10,
              "cultivation": 8,
              "karmaBad": 3
            },
            "desc": "他的笑变成了审视。'有骨气——但骨气不值钱。不过你的剑意告诉我——你不怕我。不怕就好——怕我的人太多了，没意思。'"
          }
        },
        "sceneImage": "assets/cards/events/scene_karma_k_betrayed_npc.png"
      },
      {
        "id": "sd_nd_demon_within""type": "STORY",
        "title": "心魔的低语",
        "description": "元婴突破前夕——你的心魔终于现身了。它不是幻象，是你半个月深夜不敢面对的自己的声音。'你怕什么？怕飞升是骗局？怕道侣背叛？怕你的灵根碎片突然散掉？不是——'它的声音和你一模一样——'你的灵根碎片突然散掉，你就没有价值了。你怕的是——做一个普通人。'",
        "realm": "nascent",
        "weight": 5,
        "once": true,
        "tags": [
          "self",
          "trial",
          "tribulation",
          "story"
        ],
        "choiceType": "INNER",
        "choices": {
          "left": {
            "text": "'我是怕做一个普通人——但我不怕承认'",
            "effects": {
              "daoHeart": 25,
              "cultivation": 10,
              "fortune": 5
            },
            "desc": "心魔沉默了——然后消散。不是因为被说服——是因为你承认了。心魔的力量来自隐瞒——你把它说了出来，它就失去了武器。"
          },
          "right": {
            "text": "闭口不言——不回应",
            "effects": {
              "daoHeart": 5,
              "cultivation": 15,
              "health": -10
            },
            "desc": "心魔笑了——你的沉默让它更强。它知道——只要你不承认，它就可以一直在你耳边说话。"
          }
        }},
      {
        "id": "sd_dt_bai_ren_confession""type": "STORY",
        "title": "师尊的坦白",
        "description": "白刃真人把你叫到剑冢最深处——那柄上古仙剑前。'剑出无悔——你以为这四个字是说给你听的？'他苦笑。'是说给我自己听的。我师弟发现了这柄仙剑的秘密——它不是镇宗之宝，是上界的眼睛。他杀了剑灵，叛出师门——选择了一条我不能走的路。'他转身看着你——'你觉得——他是对的还是错的？'",
        "realm": "deity",
        "weight": 8,
        "once": true,
        "npcId": "bai_ren",
        "tags": [
          "mentor",
          "truth",
          "legacy",
          "story"
        ],
        "choices": {
          "left": {
            "text": "'他用错了方法——但没选错方向'",
            "effects": {
              "daoHeart": 20,
              "karmaGood": 15,
              "fortune": 10
            },
            "desc": "白刃真人看着你——看了很久。'我花了一百二十年才接受这个答案——你只用了二十秒。'他拍了拍你的肩——'也许我师弟当年需要的不是一个掌门师兄，是一个像你这样敢说真话的师弟。'"
          },
          "right": {
            "text": "'叛出师门就是错的——不管原因是什么'",
            "effects": {
              "daoHeart": 8,
              "cultivation": 15,
              "karmaBad": 5
            },
            "desc": "他沉默了很久——然后叹了口气。'这是执事会的标准答案。但标准答案不一定是真的——你是我的关门弟子。我希望你有一天能给出自己的答案。'"
          }
        },
        "sceneImage": "assets/cards/events/scene_fd_f_master.png"
      },
      {
        "id": "sd_dt_chaos_gate""type": "STORY",
        "title": "混沌之门的钥匙",
        "description": "碎玉的第五个阶段——不是亮度，是形状。裂纹处的混沌之气在流动——形成了一个完整的齿形。这不是一块碎玉——这是一把钥匙。一把可以打开混沌之门的钥匙。天道法则在你周围清晰可见——不是用眼睛看，是用碎玉'听'——你能听到天道的心跳。它在恐惧——它在恐惧你。",
        "realm": "deity",
        "weight": 6,
        "once": true,
        "tags": [
          "truth",
          "hidden",
          "fate",
          "story"
        ],
        "choices": {
          "left": {
            "text": "打开混沌之门——看看天道之后是什么",
            "effects": {
              "daoHeart": 30,
              "cultivation": 20,
              "fortune": -20,
              "health": -20
            },
            "desc": "门在虚空中开了一条缝——不是光溢出来，是黑暗。纯粹的、原初的黑暗——天道之前的、规则之前的、恐惧之前的黑暗。你看到了——所有三个结局在你面前展开。每个结局里都有一个人——你自己——在回头看现在的你。"
          },
          "right": {
            "text": "关上它——'还没准备好'",
            "effects": {
              "daoHeart": 15,
              "fortune": 20,
              "karmaGood": 15
            },
            "desc": "你合上了裂缝。碎玉的温度慢慢降下来——它在等。你知道——下一次打开的时候，就没有回头路了。"
          }
        }},
      {
        "id": "sd_nd_luoxuan_trust""type": "STORY",
        "title": "白狐的信任",
        "description": "白落霜站在你的洞府里——不是在等你，是在替你整理那些被你忽略的杂物。她手里端着一碗参汤——和你筑基第一天喝的那碗一模一样。'恩公——不对，凌云——你的灵气最近乱了。不是修炼的问题——是心。'她把参汤放在桌上——手指在你手背上停了一下。不是暧昧，是狐族特有的'探脉'——她的灵识可以穿过你的经脉，摸到你识海深处的波澜。'你在害怕什么？'",
        "realm": "nascent",
        "weight": 8,
        "once": true,
        "npcId": "bai_luoxuan",
        "tags": [
          "companion",
          "kindness",
          "emotion",
          "story"
        ],
        "choiceType": "EMOTIONAL",
        "choices": {
          "left": {
            "text": "'我怕飞升之后——你们都不在了'",
            "effects": {
              "daoHeart": 25,
              "karmaGood": 15,
              "fortune": 10
            },
            "desc": "她沉默了很久——参汤的热气在她面前慢慢散了。然后她笑了——不是你见过的那种浅笑，是一个白狐三百年来第一次露出的、完整的笑。'飞升——不是丢掉我们。是带我们一起。你不知道吧？天狐可以和道侣共用灵压——你的境界越高，我的尾巴越多。'她端起参汤——手是稳的。'喝吧——我在。'"
          },
          "right": {
            "text": "'没什么——只是累了'",
            "effects": {
              "daoHeart": 5,
              "cultivation": 10
            },
            "desc": "她看着你——琥珀色的眼睛里没有指责，只有确认。'好——你不说，我不问。但参汤要喝。'她把碗推到你手边——然后在你对面坐下了。没有走——只是在。白狐的陪伴不需要言语——这是三千年血脉教会她的唯一一件事。"
          }
        },
        "sceneImage": "assets/cards/events/scene_fd_f_foxGratitude.png"
      },
      {
        "id": "sd_dt_all_companions_gather""type": "STORY",
        "title": "最后一面",
        "description": "混沌之门开启前夜——不是你去见他们，是他们来找你。白落霜端来最后一碗参汤。剑灵儿把你的剑磨了三遍——她不说，但剑尖颤了三下。慕青岚送来一本没有书名的册子——里面不是功法，是她替你这几十年记下的所有你忽略的事。殷血靠在门框上——没有进来，但也没有走。白刃真人最后一个到——他没有带剑。'今晚——我不是掌门。我只是你师父。'",
        "realm": "deity",
        "weight": 8,
        "once": true,
        "tags": [
          "companion",
          "mentor",
          "emotion",
          "story"
        ],
        "choiceType": "EMOTIONAL",
        "choices": {
          "left": {
            "text": "给每个人留一句话——最后的话",
            "effects": {
              "daoHeart": 30,
              "karmaGood": 20,
              "fortune": 15
            },
            "desc": "你对白落霜说——'参汤很好喝。'对剑灵儿说——'下次寅时——别一个人练。'对慕青岚说——'书我收下了。不是法宝，胜过法宝。'对殷血说——'下次见面——请你喝酒。'对白刃真人——你没有说话。你跪了下来——膝盖没有碰到地面，被他托住了。'够了——'他收回手。'我的弟子——不用跪。'"
          },
          "right": {
            "text": "让他们走——'我习惯一个人'",
            "effects": {
              "daoHeart": 5,
              "karmaBad": 5
            },
            "desc": "他们走了——一个一个。白刃真人最后一个——他在门口停了一下，没有回头。'习惯一个人——是学不会'被人需要'。希望明天——你学会。'门关上的声音很轻，但你的识海响了一次——不是灵力，是六个不同频率的心跳在同频共振了一瞬间。"
          }
        },
        "sceneImage": "assets/cards/events/scene_dt_d_before_ascension.png"
      },
      {
        "id": "sd_dt_final_choice""type": "STORY",
        "title": "飞升或留下",
        "description": "碎玉在你手中拼成了完整的一把钥匙——不是金属，是光。混沌之门在你面前缓缓张开——不是向外开，是向内开。门后不是虚空——是你。是你走这三条路之后的自己——破天者的你站在左边，守护者的你在中间，隐仙者的你在右边。三个结局的你同时开口——只有一个字。不是指令——是确认。他们在等你自己选。",
        "realm": "deity",
        "weight": 5,
        "once": true,
        "tags": [
          "truth",
          "fate",
          "self",
          "story"
        ],
        "choiceType": "INNER",
        "choices": {
          "left": {
            "text": "破天——撕开天道，让所有人自由",
            "effects": {
              "daoHeart": 40,
              "cultivation": 30,
              "fortune": -30,
              "health": -30
            },
            "desc": "你走进了混沌之门——不是被吞噬，是穿过。天道在你身后碎裂——不是破坏，是释放。无数被锁住的因果线同时断裂——修仙者不需要再逆天，因为天——不再是牢笼。柳河村的孩子们会抬头看到一道划破天空的剑痕——那道剑痕会永远留在天幕上，告诉他们——有一个人，从这里走出去的——把天劈开了一道缝。"
          },
          "right": {
            "text": "守护——不飞升，留在人间守千年",
            "effects": {
              "daoHeart": 30,
              "karmaGood": 40,
              "fortune": 20
            },
            "desc": "你关上了混沌之门——不是放弃，是选择。你落在了柳河村——不是修仙，是打铁。你的剑变成了铁锤——每一锤都落在一个孩子的手心上，教他们握剑。白落霜站在你身边——她的九条尾巴在身后慢慢展开——不是飞升，是陪。'以后——这里就是我们的家。'你说。她笑了——琥珀色的眼睛里映着村里的灯火。'好。'"
          }
        },
        "sceneImage": "assets/cards/events/scene_dt_d_heaven_dao.png"
      }
    ]
  },
  "cards:world_atmosphere": {
    "_desc": "世界氛围卡组 — 轻量叙事卡，让世界「呼吸」。茶馆流言、路人闲话、市井传说。低权重、可重复、不做重大选择。通过CardSystem._loadExtraModule加载，realm字段决定出现在哪个境界的抽卡池。",
    "cards": [
      {
        "id": "atm_qi_tea_rumor""type": "STORY",
        "title": "茶馆里的流言",
        "description": "山脚茶馆里，两个散修在角落里低声交谈。'听说了吗——青云宗又收了一个弟子。不是什么好苗子。''你怎么知道？''好苗子不会跪三天——那是没地方去的人才会做的事。'茶杯在他们手里转着——没注意到你在隔壁桌。",
        "realm": "qi",
        "weight": 4,
        "tags": [
          "atmosphere",
          "rumor",
          "sect"
        ],
        "choices": {
          "left": {
            "text": "继续听——不入流也有不入流的消息",
            "effects": {
              "fortune": 3,
              "daoHeart": 2
            },
            "desc": "他们接着聊起了剑冢——'听说青云宗的剑冢每隔几年就有弟子进去出不来。不是死在里面的——是找到了什么，然后不出来了。'茶杯磕在木桌上的声音比你想象的重。"
          },
          "right": {
            "text": "起身离开——没必要听闲话",
            "effects": {
              "daoHeart": 5
            },
            "desc": "你放下茶钱走了——但茶馆的门关上之前，你听到最后一句：'那个跪了三天的——如果他能活过炼气期，我倒想看看。'茶杯又磕了一下——像在押注。"
          }
        }
      },
      {
        "id": "atm_qi_market_old_woman""type": "STORY",
        "title": "市集里的老妪",
        "description": "修仙坊市的角落——不是卖丹药和法器的那条街，是收旧货的那条。一位老妪在卖碎布料和旧经书。她面前的摊子上摆着一块黑黢黢的石头——不是灵石，是河里随便捡的鹅卵石。但石头上刻了两个字：'回来'。不是写给修士看的——是写给走了的人。",
        "realm": "qi",
        "weight": 4,
        "tags": [
          "atmosphere",
          "mortal",
          "emotion"
        ],
        "choiceType": "EMOTIONAL",
        "choices": {
          "left": {
            "text": "买下那块石头（-5 灵石）",
            "effects": {
              "spiritStone": -5,
              "daoHeart": 8,
              "fortune": 3
            },
            "desc": "老妪不收灵石——她说：'我要这个没用。你拿着吧——我儿子当年也修仙，后来没回来。写这两个字是给我自己看的。'她把石头塞给你——手是冷的。"
          },
          "right": {
            "text": "走开——不是每段故事都该听",
            "effects": {
              "daoHeart": -2
            },
            "desc": "你走开了。但'回来'两个字在脑子里留了很久——比任何剑诀都记得清楚。"
          }
        }
      },
      {
        "id": "atm_qi_sect_gate_night",
        
        "sceneImage":"assets/cards/events/scene_pool_sect_training.png",
        "type": "STORY",
        "title": "山门夜话",
        "description": "深夜的山门——你值夜。值夜是外门弟子的必修课——不是真有人会打上来，是让新弟子学会'守'。风从石阶上吹下来——你忽然注意到石阶上有深深浅浅的痕迹。不是剑痕——是膝盖跪出来的凹槽。你跪了三天的那个位置——不是第一个，也不会是最后一个。",
        "realm": "qi",
        "weight": 3,
        "tags": [
          "atmosphere",
          "sect",
          "self"
        ],
        "choiceType": "INNER",
        "choices": {
          "left": {
            "text": "用手抚摸石阶上的凹槽——想想那些人也和你一样",
            "effects": {
              "daoHeart": 10,
              "fortune": 3
            },
            "desc": "石阶是冷的——但凹槽比周围的石头光滑。多少膝盖磨出来的。有个凹槽特别深——那个人跪了不止三天。你忽然觉得自己那三天不算什么。"
          },
          "right": {
            "text": "站直——你是来守的，不是来想的",
            "effects": {
              "daoHeart": 5,
              "cultivation": 3
            },
            "desc": "你站直了——风吹过剑鞘，发出一声低鸣。不是你的剑在响——是山门的铁链。今晚没有敌人，只有风。"
          }
        }
      },
      {
        "id": "atm_fd_blacksmith_tale""type": "STORY",
        "title": "铁匠的传说",
        "description": "山脚铁匠铺——你偶尔来这里修剑。铁匠是个断了灵根的散修——不能修仙了就修铁。他的锤子比剑重——每一下都砸出火星。'你见过剑冢里的那柄古剑没有？'他没有停锤，继续说：'我师父说——那剑不是铸出来的，是长出来的。别问我什么叫长出来的——他就是这么说的。'锤子的节奏没变——但你注意到他敲得比平时重。",
        "realm": "foundation",
        "weight": 4,
        "tags": [
          "atmosphere",
          "rumor",
          "lore",
          "sword_way"
        ],
        "choices": {
          "left": {
            "text": "'说说你师父——他也是青云弟子？'",
            "effects": {
              "daoHeart": 5,
              "fortune": 8
            },
            "desc": "锤子停了一下——然后继续。'不是。他是被逐出去的。因为他说那剑是活的。执事会说他妖言惑众。'铁匠抬头看了你一眼——'你不一样——你的剑意里没有'规矩'。'"
          },
          "right": {
            "text": "'剑怎么能长出来——别开玩笑'",
            "effects": {
              "daoHeart": 3,
              "cultivation": 3
            },
            "desc": "铁匠笑了——不是嘲笑，是那种知道秘密的笑。'你以后会懂的——希望到时候你还能回来修剑。'他继续打铁——但锤子的节奏变了——不再是砸，是敲。在等什么。"
          }
        }
      },
      {
        "id": "atm_fd_herb_elder""type": "STORY",
        "title": "药圃老人的话",
        "description": "宗门外围的药圃——种着几百种灵草，管药圃的不是执事长老，是一个没有修为的老人。没人知道他的名字。有人说是掌门的远亲，有人说是上一代的守山弟子。他每天做的事只有三件：浇水、除草、跟你说话——但只说他在乎的那句。他朝你摆摆手：'来——看看这株紫灵芝。你猜它活了多久？'",
        "realm": "foundation",
        "weight": 3,
        "tags": [
          "atmosphere",
          "sect",
          "lore"
        ],
        "choices": {
          "left": {
            "text": "'五十年？'——凑近了看",
            "effects": {
              "daoHeart": 5,
              "fortune": 5
            },
            "desc": "'错了——两百年。它长得很慢。'他摸了摸灵芝的伞盖——动作像在摸一个孩子的头。'奇怪吧——修仙的人拼命修快，它却拼命长慢。'他看着你：'有时候慢——是对的。'"
          },
          "right": {
            "text": "'我不知道——我不懂草'",
            "effects": {
              "daoHeart": 3
            },
            "desc": "'不懂没关系——它懂你。'老人笑了笑——然后继续浇水了。你不确定他是疯子还是智者——但他手里的灵芝确实比你见过的任何灵植都要大。"
          }
        }
      },
      {
        "id": "atm_fd_wandering_minstrel",
        
        "sceneImage":"assets/cards/events/scene_pool_sect_training.png",
        "type": "STORY",
        "title": "流浪琴师",
        "description": "宗门外的山路上——一个背着琴的男人在路边歇脚。他的琴没有弦——不是断了，是根本没装。他看见你在看他的琴——'你是第几个了？都没人问这把琴怎么弹。都忙着问——弦呢？'他的手指在无弦的琴上比划——像是在弹一首你听不见的歌。'你听见了吗？'他问。你什么都没听见——但他那比划着的手指让你的三片残根突然震动了一下。",
        "realm": "foundation",
        "weight": 3,
        "tags": [
          "atmosphere",
          "hidden",
          "mystery"
        ],
        "choices": {
          "left": {
            "text": "'我听不见——但我感觉到了'",
            "effects": {
              "daoHeart": 10,
              "cultivation": 5,
              "fortune": 3
            },
            "desc": "他笑了——然后把琴递给你。'试试。'你在无弦的琴上比划了一小段柳河村的乡谣。琴没响——但你的残根响了——三根一起。琴师收回了琴：'留着吧——你已经会了。'然后他走了——沿山路向上，不是下山。"
          },
          "right": {
            "text": "摇摇头——'我学剑的，不懂琴'",
            "effects": {
              "cultivation": 3
            },
            "desc": "'没关系——以后会懂的。'他站起来——背着无弦的琴沿山路向上走去。不是下山——是向着剑冢的方向。"
          }
        }
      },
      {
        "id": "atm_gd_wine_house_bet""type": "STORY",
        "title": "酒肆赌约",
        "description": "修仙坊市的酒肆里——几个散修在押注：'下一届论剑大会——青云还是血煞？'筹码哗啦啦堆在木桌上——灵石、法器、功法，什么都有。一个干瘦的老头看了看你腰间的剑穗——青云的剑穗。'小哥——你押谁？不赌也行——说说你的看法。这壶酒我请。'他把酒壶推过来——壶不是新的，是旧竹筒——散修最穷的那种。",
        "realm": "golden",
        "weight": 4,
        "tags": [
          "atmosphere",
          "rumor",
          "sect",
          "demonic"
        ],
        "choices": {
          "left": {
            "text": "'我押自己——不是青云也不是血煞'",
            "effects": {
              "daoHeart": 12,
              "fortune": 5
            },
            "desc": "酒肆安静了三秒——然后那个干瘦老头哈哈大笑。'好——好！三百年了——第一个说'我押自己'的青云弟子。'他把酒壶推过来：'这壶酒——不是请你，是敬你。'散修们开始窃窃私语——不是嘲笑，是重新打量你。"
          },
          "right": {
            "text": "'青云必胜——不需要押'",
            "effects": {
              "daoHeart": 5,
              "cultivation": 3
            },
            "desc": "几个散修交换了一个眼神——那种'又一个被宗门洗脑的'的眼神。干瘦老头笑着摇了摇头——把那壶旧竹筒酒端走了。'等你不说'必胜'的时候——我再请你。'"
          }
        }
      },
      {
        "id": "atm_gd_familys_letter_unread""type": "STORY",
        "title": "未读的家书",
        "description": "宗门邮差送来一封信——不是你养父的笔迹，是村里教书先生的代笔。信封上用炭笔写着：'柳河村——叶铁匠——托寄'。信纸折了又折——折痕多得数不清。教书先生的字工工整整：'铁匠让我写——他说你不识字的时候教过你写名字，现在你应该会看信了。他说——没事。只是告诉你他没事。'信的边角有点湿——不是下雨，是泪水干掉的痕迹。",
        "realm": "golden",
        "weight": 3,
        "tags": [
          "atmosphere",
          "mortal",
          "family",
          "emotion"
        ],
        "choiceType": "EMOTIONAL",
        "choices": {
          "left": {
            "text": "回信——'我也没事'",
            "effects": {
              "daoHeart": 15,
              "karmaGood": 10,
              "fortune": 5
            },
            "desc": "你的字歪歪扭扭的——比他教你那年好不了多少。但你写了。邮差接过信的时候看了你一眼——他认得你的剑穗。'青云弟子给凡人寄信——我送了一百年信，第一次见。'他把信在手里掂了掂——很轻。但你知道它比灵石重。"
          },
          "right": {
            "text": "把信叠好放回信封——没有回",
            "effects": {
              "daoHeart": 3
            },
            "desc": "你没回。不是不想——是不知道写什么。'没关系——下次再写'——你告诉自己。但你后来收到下封信的时候，那个'下次'已经隔了两年。"
          }
        }
      },
      {
        "id": "atm_gd_shadow_market",
        
        "sceneImage":"assets/cards/events/scene_pool_sect_training.png",
        "type": "STORY",
        "title": "暗市",
        "description": "有人递给你一张纸条——纸条不是纸，是树叶。树叶上用灵气烫出一个地址：'西市第三巷，丑时。'不是邀请，是提醒。暗市——修仙界的地下交易会，不归任何宗门管。你去了——第三巷什么都没有，只有一面镜子。镜子照的不是你——是你想买的东西。一个戴面具的人在镜子边等着：'第一次来？'",
        "realm": "golden",
        "weight": 4,
        "tags": [
          "atmosphere",
          "mystery",
          "market"
        ],
        "choices": {
          "left": {
            "text": "'看看——不买'",
            "effects": {
              "daoHeart": 5,
              "fortune": 5,
              "karmaGood": 3
            },
            "desc": "面具人摊摊手——'随便。反正来过一次的人——都会来第二次。不是买不起——是放不下。'镜子里闪过一柄剑——不是青云教的任何剑法——但剑刃和你的三脉残根同时震了一下。"
          },
          "right": {
            "text": "转身离开——暗市不是正道弟子该来的地方",
            "effects": {
              "daoHeart": 8,
              "karmaGood": 5
            },
            "desc": "你转身的时候镜子里的影像消失了——变成了一面普通的铜镜。但你走远之后——面具人对着空气说了一句：'他会回来的。他的残根——在找东西。'"
          }
        }
      },
      {
        "id": "atm_nd_ancient_ruins""type": "STORY",
        "title": "古道上的残垣",
        "description": "北荒古道上——不是现修的商道，是三千年前元婴修士飞升前走过的石阶。石阶两边是残败的城墙——不是凡人垒的，是阵法轰塌的。一块残碑斜插在土里——上面的字被时光削掉了一半。能认出来的只有三个字：'……道……不……'三脉残根同时震动。这块碑——和你有关系。",
        "realm": "nascent",
        "weight": 4,
        "tags": [
          "atmosphere",
          "ancient",
          "lore",
          "truth"
        ],
        "choices": {
          "left": {
            "text": "用灵识探查残碑——看它记住的",
            "effects": {
              "cultivation": 10,
              "daoHeart": 8,
              "fortune": 8
            },
            "desc": "灵识渗入残碑的瞬间——你看到了三千年前的一个片段：一个人站在这里的石阶上，他的三脉完整无缺。他回头看了一眼——在看你。三千年前的人——在看三千年后的你。然后残碑碎了——不是碎的石头，是时间终于追上来的声音。"
          },
          "right": {
            "text": "路过——不打扰古人",
            "effects": {
              "daoHeart": 5,
              "fortune": 5
            },
            "desc": "你没有探查——但经过残碑的时候，你的残根和石碑之间产生了一瞬间的共鸣。不是灵力——是某种更古老的东西在'相认'。"
          }
        }
      },
      {
        "id": "atm_nd_faction_spy""type": "STORY",
        "title": "茶楼里的探子",
        "description": "坊市的茶楼二楼——你一个人喝茶。隔壁桌一个穿斗篷的人在写信——不是毛笔，是灵符。灵符燃烧的微光从斗篷边缘漏出来——是血煞宗的暗号。他察觉到你注意到了——抬起斗篷——露出一张意外的脸：不是陌生人——是殷血。她笑了笑——用唇语说：'别出声。'然后把灵符烧完——灰烬在空中组成了一行字——'晚上——老地方——有情报。'然后消失了。",
        "realm": "nascent",
        "weight": 4,
        "npcId": "yin_xue",
        "tags": [
          "atmosphere",
          "demonic",
          "ally",
          "companion"
        ],
        "choices": {
          "left": {
            "text": "晚上去见她——情报可能是关于青云内鬼的",
            "effects": {
              "daoHeart": 8,
              "fortune": 5,
              "karmaGood": 3
            },
            "desc": "老地方——枯树。殷血点了一盏灵灯——不是为了照明，是为了隔音。'青云宗执事会里有人和你师父不对付——不是要杀他，是要架空他。动手的时间——下个月圆之夜。'你点头——没有问更多。她知道就够了。"
          },
          "right": {
            "text": "不去——正道弟子不应深夜见魔修",
            "effects": {
              "daoHeart": 3,
              "karmaGood": 5
            },
            "desc": "你没去。但第二天一早——殷血托人给你送来一个锦囊——打开的时候，里面传出她的声音，只有一句：'你自己选择不听的——希望你不要后悔。'"
          }
        }
      },
      {
        "id": "atm_nd_ice_cave_whisper",
        
        "sceneImage":"assets/cards/events/scene_pool_sect_training.png",
        "type": "STORY",
        "title": "冰窟中的低吟",
        "description": "极北冰原的一个冰窟里——白落霜站在你身边。她不是在修炼——在听。'你听到了吗？不是风声——是冰在唱。'她的银发在冰壁上投下淡蓝的倒影——不是灵力，是冰窟本身的寒光。她闭上眼睛：'三百年前——有一只白狐在这里等一个人。等了很久。后来她把自己冻在冰里——说要等到他回来。不是等不到——是不想忘掉。'她睁开眼——琥珀色的瞳孔里映着你。'白狐的记忆——可以传三百年。'",
        "realm": "nascent",
        "weight": 4,
        "npcId": "bai_luoxuan",
        "tags": [
          "atmosphere",
          "companion",
          "emotion",
          "ancient"
        ],
        "choiceType": "EMOTIONAL",
        "choices": {
          "left": {
            "text": "'你不会等那么久的——我不会让你等'",
            "effects": {
              "daoHeart": 15,
              "karmaGood": 10,
              "fortune": 5
            },
            "desc": "她笑了——很浅——但冰窟里的温度升了一度。不是法术——是天狐情绪的自然投影。'我知道——'她轻轻说——'因为你不是那时候的人。你是现在——现在的人不等人，只会追。'"
          },
          "right": {
            "text": "沉默——握紧她的手",
            "effects": {
              "daoHeart": 10
            },
            "desc": "你没有说话——但你的手握紧了她。冰窟里没有声音——只有冰壁上的光在看你。不是监视——是见证了太多等待之后终于看到了一次'不放手的'。"
          }
        }
      },
      {
        "id": "atm_dt_heaven_eye""type": "STORY",
        "title": "天上的眼睛",
        "description": "化神期的灵识覆盖数百里——你能感知到山脉的呼吸、河流的脉搏。但有一片区域你感知不到——就在你头顶正上方。一片黑色的区域——像一个盲点。不是你的灵识不够强——是那个盲点不想被看到。三脉残根同时震动——它们在告诉你：那是天道之眼——在看你。不是监视——是评估。它在评估——你值不值得被消灭。",
        "realm": "deity",
        "weight": 4,
        "tags": [
          "atmosphere",
          "truth",
          "hidden",
          "fate"
        ],
        "choices": {
          "left": {
            "text": "用碎玉的力量回看那只眼睛",
            "effects": {
              "daoHeart": 20,
              "cultivation": 10,
              "fortune": -10
            },
            "desc": "碎玉在你怀里发光——不是召唤，是回击。你看到了——天道之眼后面不是虚无，是无数条因果的线。每一条线都连着一个人的命运——包括你的。其中一条线——比其他的都细——上面写着四个字：'漏洞。保留。'天道不是在消灭你——是在实验你。"
          },
          "right": {
            "text": "收回灵识——不要惊动它",
            "effects": {
              "daoHeart": 8,
              "fortune": 10
            },
            "desc": "你收回了灵识——但你知道，你已经引起了它的注意。盲点移动了一寸——跟了你一寸。然后不动了——不是不看了——是记下了。"
          }
        }
      },
      {
        "id": "atm_dt_mortal_village_fade""type": "STORY",
        "title": "凡尘渐远",
        "description": "你从柳河村上空飞过——不是特意，是顺路。但你飞得很慢——慢到能看见炊烟的形状。柳河村的黄昏和六十年前一样——铁匠铺的烟、河边的洗衣石、村口的柳树——只是铁匠铺的烟不是养父点的了。他已经走了。村里没有人认得你——凡人的寿命太短了。你落在村口的柳树下——六十年前你爬上去掏鸟窝的那根树枝还在。但鸟窝已经换了七代——没有一只鸟记得你的手。",
        "realm": "deity",
        "weight": 3,
        "tags": [
          "atmosphere",
          "mortal",
          "family",
          "self"
        ],
        "choiceType": "EMOTIONAL",
        "choices": {
          "left": {
            "text": "在柳树下埋一块灵石——佑柳河村千年不衰",
            "effects": {
              "daoHeart": 20,
              "karmaGood": 15,
              "spiritStone": -100
            },
            "desc": "灵石入土的声音很轻——像你养父的锤子最后一次落在铁砧上。柳树无风自动——不是害怕，是认识你。六十年前你从它身上摔下来的时候——它接住你的那根枝条，现在还在。但它的根——比你的境界还深。凡人的根——有时候比仙人的深。"
          },
          "right": {
            "text": "看一眼就走——不留痕迹是最好的保护",
            "effects": {
              "daoHeart": 10,
              "fortune": 5
            },
            "desc": "你没有留下任何痕迹。但柳树记住了你的灵压——在未来三百年的时间里，它会在每个黄昏重复你的灵压频率。不是召唤你——是告诉村里孩子们：'有一个人——从这里走出去的——飞到了天上。'"
          }
        }
      },
      {
        "id": "atm_dt_elder_storyteller",
        
        "sceneImage":"assets/cards/events/scene_pool_sect_training.png",
        "type": "STORY",
        "title": "茶馆里讲你的故事",
        "description": "你路过一家凡间茶馆——在化神期修士的灵识中，凡人的对话像风吹叶子的声音——太轻了。但这片叶子飘进了你的灵识——茶博士在说书，说的是一个故事：'话说那青云宗的弃徒——三脉残根——从柳河村跪到山门……'你停下——不是因为他知道——是因为他不知道主角正在外面喝茶。他在编。但编得意外地准——连碎玉的颜色都说对了。",
        "realm": "deity",
        "weight": 4,
        "tags": [
          "atmosphere",
          "rumor",
          "self"
        ],
        "choices": {
          "left": {
            "text": "走进去——听他把故事讲完",
            "effects": {
              "daoHeart": 10,
              "fortune": 8
            },
            "desc": "他讲完的时候全场寂静——然后有人问：'是真的吗？'茶博士笑了——'不知道——但每次青云宗的弟子从天上飞过的时候，我都觉得是真的。'你放下茶钱——没有人认出你。你的境界太高了——凡人看不见。但茶博士盯着你的方向看了很久——他看不到你，但他感觉到了。说书人的直觉——有时候比灵识还准。"
          },
          "right": {
            "text": "离开——凡间的故事终究是故事",
            "effects": {
              "daoHeart": 5
            },
            "desc": "你飞走了。但心里知道——茶博士下次讲这个故事的时候，会加上一句：'那叶凌云——据说最近刚在云端客栈喝了一壶茶。非常普通的茶——因为他这辈子最好的茶，是在柳河村的井水里泡的。'"
          }
        }
      }
    ]
  },
  "cards:demon_path": {
    "realm": "demon_path",
    "realmName": "正魔抉择线",
    "_description": "正魔线三幕结构事件卡。第一幕：试探(炼气)8张 / 第二幕：卷入(筑基)12张 / 第三幕：深耕(金丹)15张",
    "karmaCards": {
      "demonRefused": "dp_refused_revenge",
      "demonAccepted": "dp_accepted_trial",
      "orthodoxWarned": "dp_orthodox_test",
      "demonSideChosen": "dp_demon_master_visit",
      "orthodoxSideChosen": "dp_orthodox_mentor",
      "demonInternalConflict": "dp_demon_schism",
      "orthodoxInternalConflict": "dp_orthodox_schism",
      "demonDeepBond": "dp_blood_oath",
      "orthodoxDeepBond": "dp_sect_heirloom",
      "betrayalChoice": "dp_final_stand"
    },
    "cards": [
      {
        "id": "dp_demon_whisper""type": "SPECIAL",
        "title": "耳边的低语",
        "description": "你在后山修炼时，耳边响起一个陌生的声音：'你的灵根不差——但在正道，你永远只是芸芸众生中的一个。魔道可以让你成为唯一。'你环顾四周，空无一人。",
        "realm": "qi",
        "weight": 8,
        "path": null,
        "tags": [
          "demon_path",
          "first_contact",
          "mystery"
        ],
        "choices": {
          "left": {
            "text": "'你是谁？'——追问声源",
            "effects": {
              "daoHeart": 3,
              "fortune": -5
            },
            "karmaSeed": {
              "id": "demonFirstContact",
              "seedType": "grudge",
              "delay": 8,
              "priority": 2
            }
          },
          "right": {
            "text": "无视——专心修炼",
            "effects": {
              "daoHeart": 5,
              "cultivation": 3
            }
          }
        }
      },
      {
        "id": "dp_orthodox_warning",
        
        "sceneImage":"assets/cards/events/scene_pool_path_choice.png",
        "type": "SPECIAL",
        "title": "执事长老的警告",
        "description": "宗门执事长老忽然叫住你——他的眼神很锐利。'最近有没有陌生人在后山找你说话？'他顿了顿，'如果有——立刻上报。那不是普通的散修。'",
        "realm": "qi",
        "weight": 7,
        "path": null,
        "tags": [
          "demon_path",
          "orthodox",
          "warning"
        ],
        "requiresFlags": {
          "demonFirstContact": null
        },
        "choices": {
          "left": {
            "text": "如实告知——'有声音在找我'",
            "effects": {
              "daoHeart": 8,
              "karmaGood": 5,
              "fortune": 3
            },
            "karmaSeed": {
              "id": "orthodoxWarned",
              "seedType": "karma",
              "delay": 10,
              "priority": 3
            }
          },
          "right": {
            "text": "隐瞒——'没有'",
            "effects": {
              "daoHeart": -5,
              "cultivation": 5,
              "karmaBad": 5
            },
            "karmaSeed": {
              "id": "lieToSect",
              "seedType": "grudge",
              "delay": 12,
              "priority": 2
            }
          }
        }
      },
      {
        "id": "dp_demon_face""type": "SPECIAL",
        "title": "魔道来客",
        "description": "那个声音的主人终于现身了——一个穿着黑袍的中年修士，眉心有一点殷红的印记。他的笑容很奇怪——明明在笑，却让你后背发凉。'我叫殷血——别怕，我不是来打架的。我是来给你一个选择的。'",
        "realm": "qi",
        "weight": 6,
        "path": null,
        "tags": [
          "demon_path",
          "face_to_face",
          "choice"
        ],
        "requiresFlags": {
          "demonFirstContact": null,
          "lieToSect": null
        },
        "choices": {
          "left": {
            "text": "'什么选择？'——听他说完",
            "effects": {
              "daoHeart": -3,
              "fortune": -5
            },
            "nextCard": "dp_demon_offer"
          },
          "right": {
            "text": "拔剑——'魔道妖人，滚！'",
            "effects": {
              "daoHeart": 5,
              "karmaGood": 5,
              "health": -10
            },
            "karmaSeed": {
              "id": "demonRefused",
              "seedType": "grudge",
              "delay": 15,
              "priority": 3,
              "cancelGroup": "demon_path_choice"
            }
          }
        }
      },
      {
        "id": "dp_demon_offer",
        
        "sceneImage":"assets/cards/events/scene_pool_path_choice.png",
        "type": "SPECIAL",
        "title": "魔道的饵",
        "description": "殷血摊开手掌——掌心里是一枚黑色的令牌。'拿着它——只是看看魔道是怎么修炼的。不喜欢的话，随时可以扔了。'他的语气轻描淡写，但你知道这枚令牌不简单。",
        "realm": "qi",
        "weight": 0,
        "path": null,
        "tags": [
          "demon_path",
          "offer"
        ],
        "choices": {
          "left": {
            "text": "接过令牌——'只是看看'",
            "effects": {
              "daoHeart": -8,
              "cultivation": 10,
              "karmaBad": 8
            },
            "karmaSeed": {
              "id": "demonAccepted",
              "seedType": "grudge",
              "delay": 12,
              "priority": 3,
              "cancelGroup": "demon_path_choice"
            }
          },
          "right": {
            "text": "拒绝——'不必了'",
            "effects": {
              "daoHeart": 8,
              "karmaGood": 5
            }
          }
        }
      },
      {
        "id": "dp_demon_first_lesson""type": "SPECIAL",
        "title": "第一课：魔气入体",
        "description": "你试着按照令牌里记录的方法运转魔气——一股灼热的力量从丹田涌出，和你的灵力完全不同。它在吞噬——吞噬你的杂念、你的犹豫、甚至你的怜悯。你感到自己变强了。也变冷了。",
        "realm": "qi",
        "weight": 5,
        "path": null,
        "tags": [
          "demon_path",
          "training"
        ],
        "requiresFlags": {
          "demonAccepted": null
        },
        "choices": {
          "left": {
            "text": "继续修炼魔功",
            "effects": {
              "cultivation": 15,
              "daoHeart": -10,
              "health": 5,
              "karmaBad": 10
            }
          },
          "right": {
            "text": "停下——'这不是我要的'",
            "effects": {
              "daoHeart": 15,
              "karmaGood": 10,
              "cultivation": -5
            }
          }
        }
      },
      {
        "id": "dp_orthodox_test""type": "SPECIAL",
        "title": "宗门的考验",
        "description": "执事长老单独召见你。'宗门最近发现有人在传授魔功——你是这条线索上的人。'他把一个测试法器放在桌上：'把手放上去——如果你是清白的，它不会亮。'",
        "realm": "qi",
        "weight": 6,
        "path": null,
        "tags": [
          "demon_path",
          "orthodox",
          "test"
        ],
        "requiresFlags": {
          "demonAccepted": null,
          "orthodoxWarned": null
        },
        "choices": {
          "left": {
            "text": "坦然接受测试",
            "effects": {
              "daoHeart": 5,
              "karmaGood": 5
            },
            "desc": "法器微微一亮——但长老只是皱了皱眉。'微弱的外道气息……不算违规。去吧。'"
          },
          "right": {
            "text": "拒绝——'我拒绝这种侮辱'",
            "effects": {
              "daoHeart": -3,
              "karmaBad": 3,
              "fortune": -10
            },
            "desc": "长老的目光冷了三分。'你可以拒绝——但我记住你了。'"
          }
        }
      },
      {
        "id": "dp_sect_elder_suspicion",
        
        "sceneImage":"assets/cards/events/scene_pool_path_choice.png",
        "type": "SPECIAL",
        "title": "长老的目光",
        "description": "不止一位长老开始用异样的眼光看你——不是敌意，是审视。你的修行速度太快了，快得不正常。白刃真人路过时拍了一下你的肩膀：'走得快不重要——走得稳才重要。'",
        "realm": "qi",
        "weight": 5,
        "path": null,
        "tags": [
          "demon_path",
          "orthodox",
          "suspicion"
        ],
        "choices": {
          "left": {
            "text": "放慢修炼——不出风头",
            "effects": {
              "cultivation": -5,
              "daoHeart": 8,
              "fortune": 5
            }
          },
          "right": {
            "text": "不管——实力才是硬道理",
            "effects": {
              "cultivation": 10,
              "daoHeart": -5,
              "fortune": -5,
              "karmaBad": 3
            }
          }
        }
      },
      {
        "id": "dp_end_of_qi""type": "SPECIAL",
        "title": "炼气将尽",
        "description": "炼气期的终点近在眼前。你站在山崖上，风吹来两种味道——一边是正道香火的气息，一边是远方荒原的腥甜。两条路，一个你。",
        "realm": "qi",
        "weight": 7,
        "path": null,
        "tags": [
          "demon_path",
          "act_end",
          "reflection"
        ],
        "choices": {
          "left": {
            "text": "望向正道——坚定了道心",
            "effects": {
              "daoHeart": 15,
              "karmaGood": 10,
              "fortune": 5
            }
          },
          "right": {
            "text": "望向远方——心里泛起涟漪",
            "effects": {
              "cultivation": 10,
              "daoHeart": -5,
              "fortune": -5
            }
          }
        }
      },
      {
        "id": "dp_conflict_erupts""type": "SPECIAL",
        "title": "第一次冲突",
        "description": "筑基第三天——你在坊市附近遭遇了一场伏击。袭击你的不是妖兽——是一个魔道散修。他在被你击退时大笑：'殷血大人说的没错——你还真是块好料子。'",
        "realm": "foundation",
        "weight": 8,
        "path": null,
        "tags": [
          "demon_path",
          "conflict",
          "act2"
        ],
        "choices": {
          "left": {
            "text": "追上去——问清楚谁派他来的",
            "effects": {
              "cultivation": 10,
              "daoHeart": 5,
              "health": -15
            },
            "karmaSeed": {
              "id": "huntDemonMessenger",
              "seedType": "grudge",
              "delay": 8,
              "priority": 2
            }
          },
          "right": {
            "text": "报告宗门——'有人盯着我'",
            "effects": {
              "daoHeart": 10,
              "karmaGood": 5,
              "fortune": 3
            }
          }
        }
      },
      {
        "id": "dp_ambush_by_orthodox",
        
        "sceneImage":"assets/cards/events/scene_pool_path_choice.png",
        "type": "SPECIAL",
        "title": "正道的暗箭",
        "description": "你以为正道都是光明磊落？几个同门截住了你——不是聊修炼，是怀疑你。'有人看到殷血的人找过你。解释一下。'领头的是内门弟子李寒——他的剑已经拔了一半。",
        "realm": "foundation",
        "weight": 7,
        "path": null,
        "tags": [
          "demon_path",
          "orthodox",
          "betrayal"
        ],
        "requiresFlags": {
          "demonAccepted": null
        },
        "choices": {
          "left": {
            "text": "'他只是想拉拢我——我拒绝了'（半真半假）",
            "effects": {
              "daoHeart": -5,
              "fortune": 5
            },
            "karmaSeed": {
              "id": "lieToPeers",
              "seedType": "grudge",
              "delay": 10,
              "priority": 2
            }
          },
          "right": {
            "text": "'这和你们无关'——硬碰硬",
            "effects": {
              "health": -20,
              "daoHeart": 5,
              "karmaBad": 5
            },
            "karmaSeed": {
              "id": "enmityWithPeers",
              "seedType": "grudge",
              "delay": 6,
              "priority": 3
            }
          }
        }
      },
      {
        "id": "dp_demon_recruit_again""type": "SPECIAL",
        "title": "殷血的第二次邀请",
        "description": "殷血又来了——这次不是在荒山野岭，而是在你的洞府里。他就坐在你的蒲团上，喝着你的茶。'上次的令牌还在你手上吧——用了吗？'他看起来很有耐心——魔道通常不是这样的。",
        "realm": "foundation",
        "weight": 7,
        "path": null,
        "tags": [
          "demon_path",
          "recruitment",
          "act2"
        ],
        "choices": {
          "left": {
            "text": "'你到底想从我这里得到什么？'",
            "effects": {
              "daoHeart": 3,
              "fortune": -3
            },
            "nextCard": "dp_demon_truth"
          },
          "right": {
            "text": "赶他走——'别再来了'",
            "effects": {
              "daoHeart": 8,
              "karmaGood": 5
            },
            "karmaSeed": {
              "id": "demonRefusedTwice",
              "seedType": "grudge",
              "delay": 12,
              "priority": 4
            }
          }
        }
      },
      {
        "id": "dp_demon_truth""type": "SPECIAL",
        "title": "殷血的秘密",
        "description": "殷血沉默了很久。终于开口：'我三百年前是正道弟子——和你现在一个样。后来我发现——正道修的不是道，是规矩。魔道修的不是魔，是自由。'他掀起袖子——手臂上有一道剑伤，疤痕狰狞：'这是当年白刃真人留下的。他是我师兄。'",
        "realm": "foundation",
        "weight": 0,
        "path": null,
        "tags": [
          "demon_path",
          "reveal",
          "lore"
        ],
        "choices": {
          "left": {
            "text": "'所以你是来报仇的？'",
            "effects": {
              "daoHeart": 5,
              "fortune": 5
            }
          },
          "right": {
            "text": "'你找错人了——我不是你'",
            "effects": {
              "daoHeart": 10,
              "karmaGood": 5,
              "fortune": 3
            }
          }
        }
      },
      {
        "id": "dp_blood_moon_mission",
        
        "sceneImage":"assets/cards/events/scene_pool_path_choice.png",
        "type": "SPECIAL",
        "title": "血月任务",
        "description": "宗门下发了一个任务——剿灭一处魔道据点。但到了地方你发现：那些'魔道'在护着一个村子。妖兽潮来了——正道不管，魔道在守。领队的弟子说：'不用管村民——目标只有魔修。'",
        "realm": "foundation",
        "weight": 8,
        "path": null,
        "tags": [
          "demon_path",
          "moral_test",
          "act2"
        ],
        "choices": {
          "left": {
            "text": "违抗命令——先疏散村民",
            "effects": {
              "karmaGood": 20,
              "daoHeart": 15,
              "cultivation": -5
            },
            "karmaSeed": {
              "id": "savedCivilians",
              "seedType": "karma",
              "delay": 10,
              "priority": 3
            }
          },
          "right": {
            "text": "服从命令——只针对魔修",
            "effects": {
              "cultivation": 10,
              "daoHeart": -10,
              "karmaBad": 10
            },
            "desc": "你告诉自己——这是军令。但村民的哭声让你三天没睡着。"
          }
        }
      },
      {
        "id": "dp_captured_by_demon""type": "SPECIAL",
        "title": "被俘",
        "description": "在一次混战中，你被魔道擒获——他们把你绑在祭坛上，没有马上杀你。原因很快揭晓：殷血来了。他站在你面前，居高临下，但语气出奇地平静：'你看——正道放弃了这片区域。三百年了，什么都没变。'",
        "realm": "foundation",
        "weight": 6,
        "path": null,
        "tags": [
          "demon_path",
          "capture",
          "act2"
        ],
        "requiresFlags": {
          "demonFirstContact": null
        },
        "choices": {
          "left": {
            "text": "'放了我——或者杀了我'",
            "effects": {
              "daoHeart": 10,
              "health": -10
            },
            "karmaSeed": {
              "id": "defiedDemon",
              "seedType": "karma",
              "delay": 8,
              "priority": 3
            }
          },
          "right": {
            "text": "'……正道为什么放弃这片区域？'",
            "effects": {
              "daoHeart": -5,
              "fortune": 5
            },
            "karmaSeed": {
              "id": "demonSideChosen",
              "seedType": "bloodline",
              "delay": 6,
              "priority": 5,
              "cancelGroup": "demon_path_choice"
            }
          }
        }
      },
      {
        "id": "dp_sect_council""type": "SPECIAL",
        "title": "宗门公审",
        "description": "有人把你告到了宗门公审会——理由是'私通魔道'。你站在大殿中央，四周的长老们面色各异。白刃真人沉默地看着你——他什么都没说。",
        "realm": "foundation",
        "weight": 7,
        "path": null,
        "tags": [
          "demon_path",
          "orthodox",
          "trial"
        ],
        "choices": {
          "left": {
            "text": "自辩——'我没有背叛正道'",
            "effects": {
              "daoHeart": 10,
              "fortune": -5,
              "karmaGood": 5
            }
          },
          "right": {
            "text": "沉默——让时间说话",
            "effects": {
              "daoHeart": 5,
              "fortune": 5
            }
          }
        }
      },
      {
        "id": "dp_break_from_sect",
        
        "sceneImage":"assets/cards/events/scene_pool_path_choice.png",
        "type": "SPECIAL",
        "title": "诀别师门",
        "description": "公审的结果是'无罪'——但你知道，从今天起，师门已经不再是家了。白刃真人在你离开大殿时追了上来：'不管你走哪条路——你的剑法是我教的。别丢了剑修的脸。'这是他在赶你走，还是在留你？",
        "realm": "foundation",
        "weight": 5,
        "path": "sword",
        "tags": [
          "demon_path",
          "orthodox",
          "master"
        ],
        "requiresFlags": {
          "demonAccepted": null
        },
        "choices": {
          "left": {
            "text": "'师父——我不会让你失望'",
            "effects": {
              "daoHeart": 20,
              "karmaGood": 10,
              "cultivation": 10
            }
          },
          "right": {
            "text": "沉默行礼——转身离开",
            "effects": {
              "daoHeart": 10,
              "fortune": 10,
              "karmaBad": 5
            }
          }
        }
      },
      {
        "id": "dp_demon_refugee""type": "SPECIAL",
        "title": "魔道的难民",
        "description": "你遇到了一个从魔道逃出来的人——不是修士，是个普通凡人。他全家被魔修炼成了傀儡——他逃了出来，浑身是伤。他说：'魔道说的是自由——但他们的自由是强者的自由，弱者的炼狱。'",
        "realm": "foundation",
        "weight": 6,
        "path": null,
        "tags": [
          "demon_path",
          "refugee",
          "dark_side"
        ],
        "choices": {
          "left": {
            "text": "送他去正道宗门安置",
            "effects": {
              "karmaGood": 15,
              "daoHeart": 10,
              "fortune": 5
            }
          },
          "right": {
            "text": "给他灵石——让他自己找出路",
            "effects": {
              "karmaGood": 5,
              "fortune": 3,
              "spiritStone": -10
            }
          }
        }
      },
      {
        "id": "dp_end_of_foundation""type": "SPECIAL",
        "title": "筑基将尽·分野",
        "description": "筑基期的结束近在眼前——你已经不是当年那个在后山听到低语的小修士了。你见过魔道的残酷，也见过正道的虚伪。你见过殷血的伤疤，也见过白刃真人的沉默。抉择的时刻快到了。",
        "realm": "foundation",
        "weight": 7,
        "path": null,
        "tags": [
          "demon_path",
          "act_end",
          "reflection"
        ],
        "choices": {
          "left": {
            "text": "正道——但不再是盲从的正道",
            "effects": {
              "daoHeart": 20,
              "karmaGood": 10,
              "fortune": 5
            }
          },
          "right": {
            "text": "魔道——但不做殷血那样的人",
            "effects": {
              "daoHeart": -10,
              "cultivation": 15,
              "karmaBad": 10,
              "fortune": -5
            }
          }
        }
      },
      {
        "id": "dp_demon_camp_visit",
        
        "sceneImage":"assets/cards/events/scene_pool_path_choice.png",
        "type": "SPECIAL",
        "title": "踏入魔营",
        "description": "你第一次正式踏入魔道的领地——万毒门的边界营地。这里和正道截然不同：没有规矩，只有实力。你看到两个魔修因为一块灵石大打出手，周围的人在看热闹——没有人阻止，因为'强者说了算'。",
        "realm": "golden",
        "weight": 8,
        "path": null,
        "tags": [
          "demon_path",
          "act3",
          "world"
        ],
        "requiresFlags": {
          "demonSideChosen": null
        },
        "choices": {
          "left": {
            "text": "出手制止——'这也太过了'",
            "effects": {
              "daoHeart": 10,
              "karmaGood": 10,
              "health": -20
            },
            "karmaSeed": {
              "id": "demonLawDefied",
              "seedType": "grudge",
              "delay": 8,
              "priority": 3
            }
          },
          "right": {
            "text": "旁观——魔道的规则就是如此",
            "effects": {
              "daoHeart": -5,
              "karmaBad": 5,
              "cultivation": 5
            }
          }
        }
      },
      {
        "id": "dp_demon_factions""type": "SPECIAL",
        "title": "魔道的内斗",
        "description": "魔道不是铁板一块——万毒门、血煞宗、噬心阁三大势力互相牵制。殷血所在的血煞宗主张'秩序中的自由'，而噬心阁主张'绝对自由'——包括自由地杀人。你被卷入了他们的派系之争。",
        "realm": "golden",
        "weight": 7,
        "path": null,
        "tags": [
          "demon_path",
          "act3",
          "faction"
        ],
        "requiresFlags": {
          "demonSideChosen": null
        },
        "choices": {
          "left": {
            "text": "站在血煞宗一边——秩序中的自由",
            "effects": {
              "daoHeart": 5,
              "fortune": 10
            },
            "karmaSeed": {
              "id": "demonFactionChosen",
              "seedType": "bloodline",
              "delay": 8,
              "priority": 4
            }
          },
          "right": {
            "text": "保持中立——谁也不帮",
            "effects": {
              "daoHeart": 10,
              "fortune": -10,
              "karmaGood": 5
            }
          }
        }
      },
      {
        "id": "dp_orthodox_reconnaissance""type": "SPECIAL",
        "title": "正道的间谍",
        "description": "正道联盟派了一个卧底潜入魔道——ta找到了你。'我知道你没有彻底入魔——你还有选择。帮我们——把魔道的布防图带出来，正道既往不咎。'",
        "realm": "golden",
        "weight": 7,
        "path": null,
        "tags": [
          "demon_path",
          "act3",
          "spy"
        ],
        "requiresFlags": {
          "demonSideChosen": null
        },
        "choices": {
          "left": {
            "text": "答应——'我本来就打算离开'",
            "effects": {
              "karmaGood": 20,
              "daoHeart": 15,
              "fortune": -15
            },
            "karmaSeed": {
              "id": "spyForOrthodox",
              "seedType": "karma",
              "delay": 6,
              "priority": 5
            }
          },
          "right": {
            "text": "拒绝——'正道也不是我的朋友'",
            "effects": {
              "daoHeart": 5,
              "karmaBad": 10,
              "fortune": 5
            }
          }
        }
      },
      {
        "id": "dp_demon_betrayal",
        
        "sceneImage":"assets/cards/events/scene_pool_path_choice.png",
        "type": "SPECIAL",
        "title": "魔道的背叛",
        "description": "你以为殷血对你另眼相看是因为你的天赋——错了。你只是他棋盘上的一枚棋子。他当着你面接见了一个正道使者，两人谈论的事情是：'那个正道派来的间谍——利用完之后，处理掉。'你不是间谍——但他们不需要知道这点。",
        "realm": "golden",
        "weight": 6,
        "path": null,
        "tags": [
          "demon_path",
          "act3",
          "betrayal"
        ],
        "requiresFlags": {
          "demonSideChosen": null
        },
        "choices": {
          "left": {
            "text": "当面质问殷血",
            "effects": {
              "daoHeart": 15,
              "health": -25,
              "karmaGood": 10
            },
            "karmaSeed": {
              "id": "demonBetrayal",
              "seedType": "bloodline",
              "delay": 4,
              "priority": 6
            }
          },
          "right": {
            "text": "假装不知——暗中准备后路",
            "effects": {
              "daoHeart": -5,
              "fortune": 10,
              "cultivation": 5
            }
          }
        }
      },
      {
        "id": "dp_demon_master_visit""type": "SPECIAL",
        "title": "殷血的师父",
        "description": "殷血的师父找上门了——一个活了八百年的老魔，修为深不可测。他看了看你，笑了：'殷血说你像我——我不信。但我现在信了。'他递给你一卷功法——《血煞真解》。'这是殷血没资格学的。你要不要？'",
        "realm": "golden",
        "weight": 5,
        "path": null,
        "tags": [
          "demon_path",
          "act3",
          "master"
        ],
        "requiresFlags": {
          "demonSideChosen": null
        },
        "choices": {
          "left": {
            "text": "接过——'教我'",
            "effects": {
              "cultivation": 25,
              "daoHeart": -20,
              "karmaBad": 15,
              "health": 10
            },
            "karmaSeed": {
