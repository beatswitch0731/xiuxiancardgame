          "right": {
            "text": "接受命运，从容修行",
            "effects": {
              "daoHeart": 20,
              "fortune": 15
            }
          }
        }},
      {
        "id": "k_fortune_wheel""type": "KARMA",
        "title": "命运的轮盘",
        "description": "你偶尔得到的那件东西——看似平平无奇——被一位游方道士认出来了。'此物是上古大能的本命法器碎片。你要么用它，要么毁了它——留着，只会招来杀身之祸。'",
        "realm": "golden",
        "weight": 0,
        "once": true,
        "tags": [
          "karma",
          "fortune",
