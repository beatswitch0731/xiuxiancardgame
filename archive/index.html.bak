              "karmaGood": 15,
              "daoHeart": 10,
              "fortune": -10
            }
          }
        }
      },
      {
        "id": "iw_sect_protect""type": "SPECIAL",
        "title": "师尊的包庇",
        "description": "白刃真人私下里找到你——他知道你在接触魔道。'我不问你是不是——'他顿了顿，'但是如果执事会的人来找你，我会说你在替我做任务。别让我失望。'",
        "realm": "golden",
        "weight": 5,
        "path": "sword",
        "tags": [
          "interweave",
          "sect_demonic",
          "protect"
        ],
        "requiresFlags": {
          "demonAccepted": null
        },
        "choices": {
          "left": {
            "text": "'我不会让你的包庇白费的'",
            "effects": {
              "daoHeart": 15,
              "karmaGood": 10,
              "fortune": 5
            }
          },
          "right": {
            "text": "'不必——我自己承担'",
            "effects": {
              "daoHeart": 10,
              "fortune": -5
            }
          }
        }
      },
      {
        "id": "iw_sect_demon_ambush""type": "SPECIAL",
        "title": "两难之境",
        "description": "魔道弟子袭击了宗门的一处资源点——你的任务是带队夺回。但到了现场你发现，带头的魔修是你曾经放过的那个人。他认出了你——他的手下也认出了你。",
        "realm": "golden",
        "weight": 6,
        "path": null,
        "tags": [
          "interweave",
          "sect_demonic",
          "dilemma"
        ],
        "requiresFlags": {
          "sectHuntDemon": null
        },
        "choices": {
