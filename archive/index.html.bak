              "fortune": 10,
              "health": -10
            }
          }
        }},
      {
        "id": "k_body_ascension""type": "KARMA",
        "title": "金刚不坏",
        "description": "万钧瀑布下，你一坐就是七天七夜。当第八天的晨曦刺破水帘时，你的身体发出了一声钟鸣——周围的修士都听到了。那是金刚体大成的钟声。",
        "realm": "nascent",
        "weight": 0,
        "once": true,
