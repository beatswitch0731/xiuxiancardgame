              "pill": "凝婴丹"
            },
            "desc": "财路来了——虽然不多。 +10。"
          }
        }},
      {
        "id": "n_old_rival""title": "故人重逢",
        
        "sceneImage":"assets/cards/events/scene_pool_karma_echo.png",
        "description": "你在坊市遇到了筑基期时结下的宿敌。他的修为也到了元婴——但他的道心看起来比你更沉。他说想和你再比一场。",
        "type": "NORMAL",
        "realm": "nascent",
        "weight": 8,
        "choices": {
          "left": {
            "text": "应战——以证天道",
            "effects": {
              "cultivation": 15,
              "daoHeart": 10,
              "health": -15
            },
            "desc": "此番历练，化为修行资粮。 +15。道心微芒，照亮前路。 +10。伤势加重，经脉隐隐作痛。 -15。"
          },
          "right": {
            "text": "一笑泯恩仇",
