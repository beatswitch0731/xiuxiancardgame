      "secret_body_3": {
        "id": "secret_body_3""title": "金身初成",
        "description": "石像碎裂——其中飞出一道金光撞入你的体内。你的骨骼发出金属般的共鸣声，皮肤泛起淡淡的金色光泽。这不只是炼体——是法则级的不灭金身。",
        "type": "NORMAL",
        "choices": {
          "left": {
            "text": "吸收所有金光",
            "effects": {
              "health": 35,
              "cultivation": 20,
              "daoHeart": 10
            }
          },
          "right": {
            "text": "分一缕金光给武盟",
            "effects": {
              "health": 20,
              "cultivation": 10,
              "karmaGood": 15
            }
          }
        }
      },
      "secret_pill_1": {
        "id": "secret_pill_1""title": "天地第一花",
        "description": "丹道源流的入口——一朵你从未见过的花。它不是长在土里的，是开在灵气中的。花蕊中凝结的露珠——是天地初开的'太初之水'。一滴，可以让枯木逢春。",
        "type": "NORMAL",
        "choices": {
          "left": {
            "text": "收集太初之水",
            "effects": {
              "cultivation": 10,
              "fortune": 15,
              "daoHeart": 5
            }
          },
          "right": {
            "text": "留下——不可贪婪",
            "effects": {
              "daoHeart": 15,
              "karmaGood": 10
            }
          }
        }
      },
      "secret_pill_2": {
        "id": "secret_pill_2""title": "丹道的代价",
        "description": "源流深处——一位看不清面容的老者坐在丹炉前。炉中燃烧的——不是火焰，是'时间'。他说：'我从没炼过一粒丹。我炼的是时间的起点和终点。你想学吗——代价是你从此闻不到药香。'",
        "type": "NORMAL",
        "choices": {
          "left": {
            "text": "接受——牺牲嗅觉换取丹道至高",
            "effects": {
              "cultivation": 30,
              "daoHeart": 5,
              "health": -10
            }
          },
          "right": {
            "text": "婉拒——丹道不在极致在仁心",
            "effects": {
              "daoHeart": 20,
              "karmaGood": 10,
              "fortune": 10
            }
          }
        }
      },
      "secret_pill_3": {
        "id": "secret_pill_3",
        
        "sceneImage":"assets/cards/events/scene_pool_meditation.png",
        "title": "丹心不灭",
        "description": "老者在消散前说了一句话：'你是对的——丹道不在极致。那些追求时间长度的……都失败了。丹道真正的力量——是让一颗丹能改变一个选择。'他的手指轻轻点在你的眉心——你感觉自己的识海中多了一个丹炉。",
        "type": "NORMAL",
        "choices": {
          "left": {
            "text": "开启识海丹炉",
            "effects": {
              "cultivation": 25,
              "daoHeart": 20,
              "karmaGood": 5
            }
          },
          "right": {
            "text": "将丹炉交给神农丹谷",
            "effects": {
              "cultivation": 15,
              "karmaGood": 20
            }
          }
        }
      }
    }
  },
  "cards:nascent": {
    "realm": "nascent",
    "realmName": "元婴期",
    "cards": [
      {
        "id": "n_awakening""title": "元婴初醒",
        
        "sceneImage":"assets/cards/events/scene_pool_ascension.png",
        "description": "金丹碎裂的瞬间，一个与你一模一样的婴孩在丹田内睁开了眼。它在看着你——或者说，在看着你的灵魂。",
        "type": "NORMAL",
        "realm": "nascent",
        "weight": 0,
        "once": true,
        "choices": {
