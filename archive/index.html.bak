    "cards": [
      {
        "id": "k_fox_returns""type": "KARMA",
        "title": "狐影再现",
        "description": "你曾在山中救过一只白狐。今天，一个白衣女子出现在你面前——她的眼睛像极了那只狐狸。她手里捧着一枚丹药，正是你最需要的凝婴丹。",
        "realm": "nascent",
        "weight": 0,
        "once": true,
        "tags": [
          "karma",
          "good"
        ],
        "choices": {
          "left": {
            "text": "接过丹药",
            "effects": {
              "pill": "nascent",
              "cultivation": 20,
              "daoHeart": 10
            }
          },
          "right": {
            "text": "询问她的身份",
            "effects": {
              "daoHeart": 15,
              "fortune": 10
            },
            "karmaSeed": {
              "id": "foxGratitude",
              "delay": 12,
              "realm": "deity",
              "priority": 3
            }
          }
        }},
      {
        "id": "k_fox_gratitude""type": "KARMA",
        "title": "白狐报恩·终章",
        "description": "白衣女子终于坦言——她就是你救过的那只白狐。她原本计划用千年修为为你挡一次天劫，但天道发现了她的打算。现在——她需要用另一种方式报恩。",
        "realm": "deity",
        "weight": 0,
        "once": true,
        "tags": [
          "karma",
          "good",
          "revelation"
        ],
        "choices": {
          "left": {
            "text": "让她传你白狐部的秘术",
            "effects": {
              "cultivation": 30,
              "fortune": 20,
              "daoHeart": 10
            }
          },
          "right": {
            "text": "要她保重自己",
            "effects": {
              "karmaGood": 25,
              "daoHeart": 25,
              "fortune": 15
            }
          }
        }},
      {
        "id": "k_tianshu_echo""type": "KARMA",
        "title": "万卷楼的回响",
        "description": "你开始研究《天道书》的第三天，做了一个梦。梦里有人在撕书——每一页撕下来的纸都变成了一只黑色的蝴蝶。醒来时，你发现自己手上握着一页残篇。",
        "realm": "golden",
        "weight": 0,
        "once": true,
        "tags": [
          "karma",
          "spell",
          "mystery"
        ],
        "choices": {
          "left": {
            "text": "研读残篇",
            "effects": {
              "cultivation": 20,
              "daoHeart": -10,
              "fortune": 5
            }
          },
          "right": {
            "text": "将残篇藏入万卷楼",
            "effects": {
              "daoHeart": 10,
              "karmaGood": 10
            }
          }
        },
        "sceneImage": "assets/cards/events/scene_karma_k_tianshu_echo.png"
      },
      {
        "id": "k_tianshu_revelation""type": "KARMA",
        "title": "天道书的真相",
        "description": "你终于拼出了《天道书》的完整内容——飞升不是仙路，是收割。上界每七千年发动一次'飞升'——把所有突破渡劫期的修士全部吞噬，用来维持'天道引擎'的运转。上一批被收割的，是天机老人的师兄弟。",
        "realm": "nascent",
        "weight": 0,
        "once": true,
        "tags": [
          "karma",
          "spell",
          "revelation",
          "world"
        ],
        "choices": {
          "left": {
            "text": "决定对抗天道",
            "effects": {
              "daoHeart": 30,
              "fortune": -20,
              "karmaGood": 20
            }
          },
          "right": {
            "text": "接受命运，继续修炼",
            "effects": {
              "cultivation": 25,
              "daoHeart": -15,
              "karmaBad": 15
            }
          }
        }},
      {
        "id": "k_body_echo""type": "KARMA",
        "title": "肉身试炼的回响",
        "description": "钢骨试炼过去很久了，但你发现自己的骨骼上出现了淡淡的金色纹路。殷血说这是'金刚初成'的征兆——你在无意间，已经摸到了体修的最高门槛。",
        "realm": "golden",
        "weight": 0,
        "once": true,
        "tags": [
