            },
            "desc": "此番历练，化为修行资粮。 +15。你的道心愈发坚定。 +10。善念一动，功德加身。 +5。"
          },
          "right": {
            "text": "以剑斩心魔",
            "effects": {
              "daoHeart": 5,
              "cultivation": 10,
              "health": -15
            },
            "desc": "你对大道的感悟又深了一层。 +10。你的道心愈发坚定。 +5。伤势加重，经脉隐隐作痛。 -15。"
          }
        }},
      {
        "id": "n_hunt""title": "元婴猎杀",
        "description": "你听说有邪修专门猎杀新结元婴的修士——元婴是上佳的炼丹材料。你的元婴在丹田内颤抖，但你感觉到的不是恐惧——是愤怒。",
        "type": "COMBAT",
        "realm": "nascent",
        "weight": 10,
        "tags": [
          "combat"
        ],
        "choices": {
          "left": {
            "text": "主动出击，先发制人",
            "effects": {
              "cultivation": 20,
              "health": -20,
              "karmaBad": 5
            }
          },
          "right": {
            "text": "设陷阱诱敌",
            "effects": {
              "cultivation": 15,
              "fortune": 5,
              "daoHeart": 5
            }
          }
        },
        "enemy": {
          "name": "邪修·噬婴道人",
          "hp": 60,
          "atk": 15,
          "def": 5,
          "critRate": 10,
          "special": "噬魂夺魄",
          "specialChance": 0.3,
          "specialDmg": 10,
          "factionId": "xuesha_sect"
        },
        "combatRewards": {
          "cultivation": 20,
          "spiritStone": 25
        }},
      {
        "id": "n_cave",
        
        "sceneImage":"assets/cards/events/scene_pool_karma_echo.png",
        "title": "元婴洞天",
        "description": "元婴告诉你——有一处上古洞天只有元婴出窍才能进入。你的肉身留在外面，元婴探入洞天——里面堆满了万年前的宝物。",
        "type": "NORMAL",
        "realm": "nascent",
        "weight": 12,
        "choices": {
          "left": {
