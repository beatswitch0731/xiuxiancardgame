            }
          }
        }},
      {
        "id": "k_comp_sacrifice""type": "KARMA",
        "title": "道侣的牺牲",
        "description": "你重伤昏迷的三天里，你的道侣用自己的元神为你温养经脉。醒来时，ta头发白了一半。ta笑着说'没事'——但你知道，ta损失了至少三十年的修为。",
        "realm": "golden",
        "weight": 0,
        "once": true,
        "tags": [
          "karma",
          "companion",
          "sacrifice"
        ],
        "choices": {
