    "cards": [
      {
        "id": "rb_memory_sword""type": "DESTINY",
        "title": "前世记忆·剑意",
        "description": "你拿起剑时——手指不自觉地掐了一个前世最拿手的剑诀。肌肉记得，灵根不记得。剑诀的力量远不如前世，但那股熟悉的触感让你心头一颤：你的手曾经握过更好的剑。",
        "realm": "qi,foundation",
        "weight": 0,
        "once": true,
        "tags": [
          "rebirth",
          "memory",
          "sword"
        ],
        "requirements": {
          "minLifeCount": 1,
          "pastPath": "sword"
        },
        "choices": {
          "left": {
            "text": "顺势而为——重走剑修之路",
            "effects": {
              "cultivation": 10,
              "daoHeart": 8,
              "fortune": 3
            }
          },
          "right": {
            "text": "今生换一条路——不重复前世",
            "effects": {
              "daoHeart": 12,
              "fortune": 5
            }
          }
        }
      },
      {
        "id": "rb_memory_spell",
        
        "sceneImage":"assets/cards/events/scene_pool_destiny_fate.png",
        "type": "DESTINY",
        "title": "前世记忆·法术",
        "description": "你第一次运转灵力时——法诀自动成形了。那手势、那韵律——你今生的身体还没学会，但你前世的手指记得。太古法阵的残影在你指尖一闪而过。你的法修之路，比别人快了好几倍——但也危险好几倍。",
        "realm": "qi,foundation",
        "weight": 0,
        "once": true,
        "tags": [
          "rebirth",
          "memory",
          "spell"
        ],
        "requirements": {
          "minLifeCount": 1,
          "pastPath": "spell"
        },
        "choices": {
          "left": {
            "text": "追寻前世的法——找到未尽的路",
            "effects": {
              "cultivation": 15,
              "daoHeart": 5,
              "fortune": -5
            }
          },
          "right": {
            "text": "避开前世的陷阱——学新的法术",
            "effects": {
              "daoHeart": 15,
              "fortune": 5
            }
          }
        }
      },
      {
        "id": "rb_memory_pill""type": "DESTINY",
        "title": "前世记忆·丹道",
        "description": "你第一次炼丹就成功了——炼出的丹品质之高让旁观的老修士目瞪口呆。因为你前世的丹道修为已经成了你的本能——你闭着眼睛都知道火候几时该变。但你闻到了一股焦味——不是丹炉，是你前世死亡的焦味。你的前世是炼丹炼到道基崩塌而死的。",
        "realm": "qi,foundation",
        "weight": 0,
        "once": true,
        "tags": [
          "rebirth",
          "memory",
          "pill"
        ],
        "requirements": {
          "minLifeCount": 1,
          "pastPath": "pill"
        },
        "choices": {
          "left": {
            "text": "继续炼丹——但记住前世的教训",
            "effects": {
              "cultivation": 10,
              "daoHeart": 10,
              "fortune": 10
            }
          },
          "right": {
            "text": "戒丹——前世就是死在丹上的",
            "effects": {
              "daoHeart": 15,
              "health": 5,
              "cultivation": -5
            }
          }
        }
      },
      {
        "id": "rb_memory_body""type": "DESTINY",
        "title": "前世记忆·金刚骨",
        "description": "你的肉身比同阶修士坚韧得多——不是修炼的结果，是前世的遗赠。你前世练体成痴——把骨骼淬炼到了金刚境界，然后死于肉身太强而道心跟不上。骨头的记忆留在了你的轮回里——比道心的记忆还深。",
        "realm": "qi,foundation",
        "weight": 0,
        "once": true,
        "tags": [
          "rebirth",
          "memory",
          "body"
        ],
        "requirements": {
          "minLifeCount": 1,
          "pastPath": "body"
        },
        "choices": {
          "left": {
            "text": "善用金刚骨——走体修大道",
            "effects": {
              "health": 15,
              "cultivation": 5,
              "daoHeart": 5
            }
          },
          "right": {
