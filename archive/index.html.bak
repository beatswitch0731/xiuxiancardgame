<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>一念仙途 · 修仙卡牌决策</title>
  <link rel="stylesheet" href="styles/style.css">
</head>
<body>
  <div id="app">
    <!-- 开始界面 -->
    <section id="start-screen" class="screen active">
      <div class="start-bg" style="background: url('assets/backgrounds/bg_start.png') center/cover no-repeat;"></div>
      <div class="start-content">
        <h1 class="game-title">一念仙途</h1>
        <p class="game-subtitle">左右滑动，抉择仙途</p>
        <p class="game-desc">每一次选择都是因果。你的修仙之路，由你书写。</p>

        <div class="name-creation" id="name-creation">
          <h2>道号 · 自取名讳</h2>
          <p class="name-hint">仙途漫漫，先留下你的名字（4字以内）</p>
          <div class="name-input-wrap">
            <input type="text" id="name-input" class="name-input" maxlength="4" placeholder="叶凌云" autocomplete="off">
            <span class="name-char-count" id="name-char-count">0/4</span>
          </div>
          <button class="btn-primary name-confirm-btn" id="name-confirm-btn">踏入仙途</button>
        </div>

        <div class="path-selection" id="path-selection" style="display:none;">
          <h2>选择功法</h2>
          <div class="path-grid">
            <button class="path-btn" data-path="sword">
              <img class="path-icon-img" src="assets/icons/icon_sword.png" alt="剑修">
              <span class="path-name">剑修</span>
              <span class="path-desc">一剑破万法，高攻高风险</span>
            </button>
            <button class="path-btn" data-path="spell">
              <img class="path-icon-img" src="assets/icons/icon_spell.png" alt="法修">
              <span class="path-name">法修</span>
              <span class="path-desc">诸术并修，多选项策略</span>
            </button>
            <button class="path-btn" data-path="body">
              <img class="path-icon-img" src="assets/icons/icon_body.png" alt="体修">
              <span class="path-name">体修</span>
              <span class="path-desc">肉身成圣，气血雄厚</span>
            </button>
            <button class="path-btn" data-path="pill">
              <img class="path-icon-img" src="assets/icons/icon_pill.png" alt="丹修">
              <span class="path-name">丹修</span>
              <span class="path-desc">以丹入道，资源转换</span>
            </button>
          </div>
        </div>

        <div class="start-tips">
          <p>💡 提示：可以用键盘方向键操作，也可以鼠标/手指滑动卡牌</p>
        </div>
      </div>
    </section>

    <!-- 游戏主界面 -->
    <section id="game-screen" class="screen">
      <div class="top-bar">
        <div class="top-info">
          <span class="badge realm" id="top-realm">炼气期</span>
          <span class="badge chapter" id="top-chapter">第一章：凡尘初醒</span>
          <span class="badge path" id="top-path">剑修</span>
          <span class="badge quest" id="top-quest" style="display:none; background: rgba(163,113,247,0.15); color: #a371f7; border: 1px solid rgba(163,113,247,0.3);">支线</span>
        </div>
        <div class="top-resources">
          <span class="resource" title="灵石"><img class="res-icon-img" src="assets/icons/icon_spirit_stone.png" alt="灵石"> <span id="top-spiritStone">0</span></span>
          <span class="resource" title="寿元"><img class="res-icon-img" src="assets/icons/icon_lifespan.png" alt="寿元"> <span id="top-lifespan">0</span></span>
          <span class="resource" title="轮数">🔄 <span id="top-turn">0</span></span>
          <button class="npc-list-btn" id="npc-list-btn" title="江湖人物">👤</button>
          <button class="npc-list-btn" id="bestiary-btn" title="万物志">📖</button>
          <button class="npc-list-btn" id="thread-panel-btn" title="故事线">🔗</button>
        </div>
      </div>
      <!-- 位置栏 -->
      <div class="location-bar" id="location-bar">
        <span class="loc-icon" id="loc-icon">🏯</span>
        <span class="loc-name" id="loc-name">青云宗</span>
        <span class="loc-mood" id="loc-mood">晨雾未散，青石阶上露水沾衣。</span>
      </div>

      <!-- 突破倒计时 -->
      <div class="breakthrough-bar" id="breakthrough-bar">
        <div class="bt-label" id="bt-label">🔥 筑基突破进度</div>
        <div class="bt-track"><div class="bt-fill" id="bt-fill"></div></div>
        <div class="bt-pct" id="bt-pct">0%</div>
      </div>

      <div class="game-layout">
        <aside class="attribute-panel">
          <div class="panel-decoration top"></div>
          <div class="panel-header">
            <span class="panel-icon">☯</span>
            <span class="panel-title">灵根·天机</span>
          </div>
          <div class="panel-body">
            <div class="attr-item" data-attr="cultivation" data-tooltip="修为：修炼进度核心指标，影响突破概率与可探索区域">
              <div class="attr-icon c-icon-xiu">⚔</div>
              <div class="attr-info">
                <div class="attr-label" id="label-cultivation">修为 0</div>
                <div class="attr-bar"><div class="attr-fill cultivation" id="bar-cultivation">0</div></div>
              </div>
            </div>
            <div class="attr-item" data-attr="daoHeart" data-tooltip="道心：抵抗心魔与诱惑的意志力，影响关键选择时的坚定度">
              <div class="attr-icon c-icon-xin">◈</div>
              <div class="attr-info">
                <div class="attr-label" id="label-daoHeart">道心 0</div>
                <div class="attr-bar"><div class="attr-fill daoHeart" id="bar-daoHeart">0</div></div>
              </div>
            </div>
            <div class="attr-item" data-attr="karmaGood" data-tooltip="善因 ── 你做过的好事会种下『因果种子』，延迟若干回合后发芽为奖励事件。善因越高，良缘/NPC好感/稀有奇遇概率越高。每3颗善因种子会合并为更强的大善事件。⚠ 首次遇到『因果涟漪』卡时表示一颗种子正在影响世界。">
              <div class="attr-icon c-icon-shan">◎</div>
              <div class="attr-info">
                <div class="attr-label" id="label-karmaGood">善因 0</div>
                <div class="attr-bar"><div class="attr-fill karmaGood" id="bar-karmaGood">0</div></div>
              </div>
            </div>
            <div class="attr-item" data-attr="karmaBad" data-tooltip="恶因 ── 你做的坏事/杀伐/背约也会种下种子，延迟后招来灾厄。恶因越高，敌人强度/天劫难度越大，但与魔道功法和血煞老祖的同盟度也会提升。善因与恶因相遇时可能互相抵消。">
              <div class="attr-icon c-icon-e">◆</div>
              <div class="attr-info">
                <div class="attr-label" id="label-karmaBad">恶因 0</div>
                <div class="attr-bar"><div class="attr-fill karmaBad" id="bar-karmaBad">0</div></div>
              </div>
            </div>
            <div class="attr-item" data-attr="fortune" data-tooltip="福缘：天命气运，影响稀有物品掉落率、奇遇事件触发、集市商品品质">
              <div class="attr-icon c-icon-fu">✤</div>
              <div class="attr-info">
                <div class="attr-label" id="label-fortune">福缘 0</div>
                <div class="attr-bar"><div class="attr-fill fortune" id="bar-fortune">0</div></div>
              </div>
            </div>
            <div class="attr-item" data-attr="health" data-tooltip="气血：当前生命值，归零则道消身陨，可通过丹药或修炼恢复">
              <div class="attr-icon c-icon-qi">❤</div>
              <div class="attr-info">
                <div class="attr-label" id="label-health">气血 0</div>
                <div class="attr-bar"><div class="attr-fill health" id="bar-health">0</div></div>
              </div>
            </div>
          </div>
          <div class="panel-divider">
            <span class="divider-dot">◆</span>
            <span class="divider-label">法宝·功法</span>
            <span class="divider-dot">◆</span>
          </div>
          <div class="panel-passives" id="panel-passives">
            <div class="passive-row" id="passive-hpRegen" data-tooltip="每轮自动恢复的气血值">
              <span class="passive-icon">💚</span>
              <span class="passive-val">+0</span>
              <span class="passive-label">回血/轮</span>
            </div>
            <div class="passive-row" id="passive-fortune" data-tooltip="每轮额外获得的福缘值">
              <span class="passive-icon">✨</span>
              <span class="passive-val">+0</span>
              <span class="passive-label">福缘/轮</span>
            </div>
            <div class="passive-row" id="passive-atk" data-tooltip="战斗时的攻击力加成">
              <span class="passive-icon">⚔</span>
              <span class="passive-val">+0</span>
              <span class="passive-label">攻击</span>
            </div>
            <div class="passive-row" id="passive-def" data-tooltip="战斗时的防御力减伤">
              <span class="passive-icon">🛡</span>
              <span class="passive-val">+0</span>
              <span class="passive-label">防御</span>
            </div>
            <div class="passive-row" id="passive-crit" data-tooltip="战斗时的暴击概率">
              <span class="passive-icon">💥</span>
              <span class="passive-val">+0%</span>
              <span class="passive-label">暴击</span>
            </div>
          </div>
          <div class="panel-decoration bottom"></div>
        </aside>

        <main class="card-area">
          <div class="card" id="card">
            <div class="card-portrait" id="card-portrait" style="display:none;">
              <canvas id="card-portrait-canvas" width="512" height="768"></canvas>
            </div>
            <div class="card-header">
              <span class="card-type" id="card-type">事件</span>
              <div class="thread-indicator" id="thread-indicator" style="display:none;">
                <span class="thread-bar" id="thread-bar"></span>
                <span class="thread-name" id="thread-name"></span>
                <span class="thread-phase" id="thread-phase"></span>
              </div>
              <h2 class="card-title" id="card-title">卡牌标题</h2>
              <button class="portrait-switch-btn" id="portrait-switch-btn" title="切换立绘" style="display:none;">🔄</button>
            </div>
            <div class="card-body">
              <p class="card-description" id="card-description">卡牌描述...</p>
            </div>
          </div>

          <div class="choice-buttons">
            <button class="choice-btn up" id="choice-up" data-dir="up">
              <span class="choice-arrow">↑</span>
              <span class="choice-text">选择</span>
              <span class="choice-desc"></span>
            </button>
            <div class="choice-row">
              <button class="choice-btn left" id="choice-left" data-dir="left">
                <span class="choice-arrow">←</span>
                <span class="choice-text">选择</span>
                <span class="choice-desc"></span>
              </button>
              <button class="choice-btn right" id="choice-right" data-dir="right">
                <span class="choice-arrow">→</span>
                <span class="choice-text">选择</span>
                <span class="choice-desc"></span>
              </button>
            </div>
            <button class="choice-btn down" id="choice-down" data-dir="down">
              <span class="choice-arrow">↓</span>
              <span class="choice-text">选择</span>
              <span class="choice-desc"></span>
            </button>
          </div>
        </main>

        <!-- 右侧日志面板 — 始终可见，竖向滚动 -->
        <aside class="log-sidebar" id="log-sidebar">
          <div class="log-sidebar-header">
            <span class="log-sidebar-title">仙途日志</span>
            <span class="log-sidebar-count" id="log-count">0</span>
          </div>
          <div class="log-sidebar-body" id="log-container"></div>
        </aside>
      </div>

      <!-- 叙事连贯性层：卡牌间过渡文字覆盖层（方案B） -->
      <div class="transition-overlay" id="transition-overlay"></div>

      <!-- 故事线程侧边面板 -->
      <div class="thread-side-panel" id="thread-panel" style="display:none;">
        <div class="thread-panel-header">
          <span class="thread-panel-title">🔗 故事线</span>
          <button class="thread-panel-close" id="thread-panel-close">✕</button>
        </div>
        <div class="thread-panel-section">
          <h4 class="thread-section-title active-threads-title">⚡ 进行中</h4>
          <div id="active-threads" class="thread-list">
            <p class="thread-empty">暂无活跃故事线</p>
          </div>
        </div>
        <div class="thread-panel-section">
          <h4 class="thread-section-title completed-threads-title">✅ 最近完成</h4>
          <div id="completed-threads" class="thread-list">
            <p class="thread-empty">尚无完成的故事线</p>
          </div>
        </div>
        <div class="thread-panel-section">
          <h4 class="thread-section-title seeds-title">🌱 因果线索</h4>
          <div id="pending-seeds" class="thread-list">
            <p class="thread-empty">暂无线索等待发芽</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 死亡/转世界面 -->
    <section id="death-screen" class="screen">
      <div class="death-content">
        <h2 id="death-title">道消身陨</h2>
        <p id="death-reason">你死了</p>
        <div class="death-stats" id="death-stats"></div>
        <button class="btn-primary" id="reincarnate-btn">转世重修</button>
      </div>
    </section>

    <!-- NPC人物面板（弹窗） -->
    <div class="modal-overlay" id="npc-panel" style="display:none;">
      <div class="npc-panel-content">
        <button class="modal-close" id="npc-panel-close">✕</button>
        <div class="npc-panel-header">
          <div class="npc-avatar" id="npc-avatar"><canvas id="npc-avatar-canvas" width="512" height="768"></canvas></div>
          <div class="npc-title-block">
            <h2 id="npc-name">角色名</h2>
            <p class="npc-subtitle" id="npc-subtitle">称号</p>
            <div class="npc-relationship" id="npc-relationship">关系: 陌路</div>
          </div>
        </div>
        <div class="npc-mood-section">
          <span class="mood-badge" id="npc-emotion">平静</span>
          <span class="mood-badge mindset" id="npc-mindset">通明</span>
          <span class="mood-badge location" id="npc-location">宗门</span>
        </div>
        <div class="npc-dialogue-box" id="npc-dialogue">"..."</div>
        <div class="npc-actions">
          <button class="npc-action-btn" data-action="闲聊">💬 闲聊</button>
          <button class="npc-action-btn" data-action="请教">📖 请教</button>
          <button class="npc-action-btn" data-action="赠礼">🎁 赠礼</button>
          <button class="npc-action-btn" data-action="论道">☯ 论道</button>
          <button class="npc-action-btn exit" data-action="告辞">🚪 告辞</button>
        </div>
        <div class="npc-detail-section">
          <div class="npc-detail-block">
            <h4>📜 互动记录</h4>
            <div id="npc-interactions" class="npc-detail-list"></div>
          </div>
          <div class="npc-detail-block">
            <h4>🔍 你知道的事</h4>
            <div id="npc-known-info" class="npc-detail-list"></div>
          </div>
        </div>
        <div class="npc-action-result" id="npc-result" style="display:none;"></div>
      </div>
    </div>

    <!-- 道侣面板（弹窗） -->
    <div class="modal-overlay" id="companion-panel" style="display:none;">
      <div class="npc-panel-content">
        <button class="modal-close" id="comp-panel-close">✕</button>
        <div class="npc-panel-header">
          <div class="npc-avatar" id="comp-avatar"><canvas id="comp-avatar-canvas" width="512" height="768"></canvas></div>
          <div class="npc-title-block">
            <h2 id="comp-name">道侣名</h2>
            <p class="npc-subtitle" id="comp-subtitle">称号</p>
          </div>
        </div>
        <div class="npc-mood-section">
          <span class="mood-badge" id="comp-emotion">平静</span>
          <span class="mood-badge location" id="comp-location">宗门</span>
        </div>
        <div class="companion-stats">
          <div class="comp-stat"><span>好感</span><div class="comp-stat-bar"><div class="comp-stat-fill affection" id="comp-aff-bar"></div></div><span id="comp-aff-val">0</span></div>
          <div class="comp-stat"><span>羁绊</span><div class="comp-stat-bar"><div class="comp-stat-fill bond" id="comp-bond-bar"></div></div><span id="comp-bond-val">Lv0</span></div>
          <div class="comp-stat"><span>信任</span><div class="comp-stat-bar"><div class="comp-stat-fill trust" id="comp-trust-bar"></div></div><span id="comp-trust-val">0</span></div>
        </div>
        <div class="npc-dialogue-box" id="comp-dialogue">"..."</div>
        <div class="npc-actions">
          <button class="npc-action-btn" data-action="闲聊">💬 谈心</button>
          <button class="npc-action-btn" data-action="赠礼">🎁 赠礼</button>
          <button class="npc-action-btn exit" data-action="告辞">🚪 告辞</button>
        </div>
        <div class="npc-detail-section">
          <div class="npc-detail-block">
            <h4>💕 道侣事件史</h4>
            <div id="comp-events" class="npc-detail-list"></div>
          </div>
        </div>
        <div class="npc-action-result" id="comp-result" style="display:none;"></div>
      </div>
    </div>

    <!-- NPC列表弹窗 -->
    <div class="modal-overlay" id="npc-list-panel" style="display:none;">
      <div class="npc-list-content">
        <button class="modal-close" id="npc-list-close">✕</button>
        <h2>江湖人物</h2>
        <div id="npc-list-container" class="npc-list-grid"></div>
      </div>
    </div>

    <!-- 万物志面板 -->
    <div class="modal-overlay" id="bestiary-panel" style="display:none;">
      <div class="bestiary-content">
        <button class="modal-close" id="bestiary-close">✕</button>
        <h2 class="bestiary-title">📖 万物志</h2>
        <div class="bestiary-tabs">
          <button class="bestiary-tab active" data-tab="companions">♥ 道侣</button>
          <button class="bestiary-tab" data-tab="items">🔮 万物</button>
          <button class="bestiary-tab" data-tab="techniques">📜 功法</button>
          <button class="bestiary-tab" data-tab="fragments">🧩 残卷</button>
        </div>

        <!-- 道侣标签页 -->
        <div class="bestiary-tab-content" id="bestiary-companions">
          <div id="bestiary-companion-list"></div>
        </div>

        <!-- 万物标签页 -->
        <div class="bestiary-tab-content" style="display:none;" id="bestiary-items">
          <div class="bestiary-section">
            <h3>💎 灵石与资源</h3>
            <div class="bestiary-item-grid" id="bestiary-resources"></div>
          </div>
          <div class="bestiary-section">
            <h3>🗡 法宝</h3>
            <div class="bestiary-item-grid" id="bestiary-treasures"></div>
          </div>
          <div class="bestiary-section">
            <h3>💊 丹药</h3>
            <div class="bestiary-item-grid" id="bestiary-pills"></div>
          </div>
        </div>

        <!-- 残卷标签页 -->
        <div class="bestiary-tab-content" style="display:none;" id="bestiary-fragments">
          <div class="bestiary-section">
            <h3>🧩 传承残卷收集</h3>
            <div id="bestiary-fragment-list"></div>
          </div>
          <div class="bestiary-section" id="bestiary-bonuses-section" style="display:none;">
            <h3>✨ 已激活传承加成</h3>
            <div id="bestiary-bonuses-list"></div>
          </div>
        </div>

        <!-- 功法标签页 -->
        <div class="bestiary-tab-content" style="display:none;" id="bestiary-techniques">
          <div class="bestiary-section">
            <h3 id="bestiary-path-name">当前功法</h3>
            <div id="bestiary-skills-list"></div>
          </div>
        </div>

        <!-- 立绘详情弹窗（内嵌在万物志中） -->
        <div class="bestiary-portrait-viewer" id="bestiary-portrait-viewer" style="display:none;">
          <button class="bestiary-back-btn" id="bestiary-portrait-back">← 返回</button>
          <div class="bestiary-portrait-stage" id="bestiary-stage-info"></div>
          <div class="bestiary-portrait-canvas-wrap">
            <canvas id="bestiary-portrait-canvas" width="512" height="768"></canvas>
          </div>
          <div class="bestiary-stage-selector" id="bestiary-stage-selector"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- 商店面板（坊市集市） -->
  <div class="modal-overlay" id="shop-panel" style="display:none;">
    <div class="shop-content">
      <button class="modal-close" id="shop-close">✕</button>
      <h2 class="shop-title">🏪 坊市集市</h2>
      <div class="shop-spirit-stone">
        灵石：<span id="shop-spirit-stone-val">0</span>
      </div>
      <div class="shop-items" id="shop-items-container"></div>
      <button class="btn-primary shop-leave-btn" id="shop-leave-btn">离开集市</button>
    </div>
  </div>

  <!-- ============ 核心基础设施 ============ -->
  <script src="src/core/EventBus.js"></script>
  <script src="src/core/DataLoader.js"></script>

  <!-- ============ 数据内联 (DATA_MODULES) ============ -->
  <script>
