              "daoHeart": 10,
              "fortune": -20,
              "health": -15
            },
            "nextCard": "iw_family_saved"
          },
          "right": {
            "text": "冷静——先派人打探真假",
            "effects": {
              "daoHeart": 5,
              "fortune": 5
            }
          }
        }
      },
      {
        "id": "iw_family_saved""type": "SPECIAL",
        "title": "母亲的眼泪",
        "description": "你的母亲真的在万毒门——但她是自愿来的。'他们说你在做危险的事——娘帮不了你修行，但娘可以帮你求他们不要伤害你。'她跪在魔道长老面前替你求情——一个凡人，跪在一群可以弹指间杀了她的修士面前。",
        "realm": "golden",
        "weight": 0,
        "path": null,
        "tags": [
          "interweave",
          "demonic_mortal",
          "family"
        ],
        "choices": {
          "left": {
            "text": "拉母亲起来——'娘——不值得'",
            "effects": {
              "daoHeart": 25,
              "karmaGood": 15,
              "cultivation": 5
            }
          },
          "right": {
            "text": "对魔道长老说——'有本事冲我来'",
            "effects": {
              "daoHeart": 15,
              "karmaBad": 10,
              "health": -20,
              "fortune": -10
            }
          }
        }
      },
      {
        "id": "iw_sect_family_clash""type": "SPECIAL",
        "title": "宗门与家族",
        "description": "宗门要求所有弟子断绝凡尘关系——'一心向道，凡人羁绊是修行的最大障碍。'但你的家族每年都来山门送东西——母亲做的糕点，父亲酿的酒。执事长老问：'你是修士还是凡人？'",
        "realm": "golden",
        "weight": 5,
        "path": null,
        "tags": [
          "interweave",
          "sect_mortal",
          "conflict"
        ],
        "choices": {
          "left": {
            "text": "'我是修士——但也是儿子'",
            "effects": {
              "daoHeart": 20,
              "karmaGood": 10,
              "fortune": -5
            },
            "karmaSeed": {
              "id": "sectFamilyConflict",
              "seedType": "karma",
              "delay": 8,
              "priority": 3
            }
          },
          "right": {
            "text": "断绝关系——'让他们走吧'",
            "effects": {
              "daoHeart": -15,
              "cultivation": 15,
              "karmaBad": 10
            }
          }
        }
      },
      {
        "id": "iw_sect_family_unity",
        
        "sceneImage":"assets/cards/events/scene_pool_story_moment.png",
        "type": "SPECIAL",
        "title": "道与亲",
        "description": "你抗住了宗门的压力，没有断绝凡尘关系。三年后，你的家族在宗门山下开了一家小客栈——修士们渐渐发现，这家客栈的老板娘比你见过的任何长老都懂人情世故。她煮的茶能让暴躁的剑修安静下来。",
        "realm": "golden",
        "weight": 3,
        "path": null,
        "tags": [
          "interweave",
          "sect_mortal",
          "resolution"
        ],
        "requiresFlags": {
          "sectFamilyConflict": null
        },
        "choices": {
          "left": {
            "text": "常回家看看——陪母亲喝茶",
            "effects": {
              "daoHeart": 15,
              "karmaGood": 10,
              "fortune": 10
            }
          },
          "right": {
            "text": "远远看着——不想引来麻烦",
            "effects": {
              "daoHeart": 5,
              "fortune": 5
            }
          }
        }
      },
      {
        "id": "iw_cut_ties_tribulation""type": "SPECIAL",
        "title": "天劫·无情道",
        "description": "天劫降临了——因为你斩断了红尘羁绊，天道给了你一条'清净路'。雷劫劈下来的时候，你看到每一道雷光里都映着一张脸——母亲、朋友、曾经爱过的人。天道在问：'你真的能忘？'",
        "realm": "golden",
        "weight": 5,
        "path": null,
        "tags": [
          "interweave",
          "mortal_heaven",
          "tribulation"
        ],
        "requiresFlags": {
          "cutMortalTies": null
        },
        "choices": {
          "left": {
            "text": "'不能忘——那就让天劫来得更猛烈些'",
            "effects": {
              "daoHeart": 25,
              "health": -30,
              "cultivation": 15,
              "karmaGood": 15
            },
            "desc": "天劫被你的道心震动了——它没见过一个修士敢这么对它说话。雷光中的脸消失了——不是因为天道放过了你，是因为你的记忆比天劫还坚硬。"
          },
          "right": {
            "text": "闭上眼睛——接受天劫的净化",
            "effects": {
              "cultivation": 20,
              "daoHeart": -15,
              "health": -15,
              "karmaBad": 5
            }
          }
        }
      },
      {
        "id": "iw_keep_ties_tribulation""type": "SPECIAL",
        "title": "天劫·有情道",
        "description": "天劫来了——但因为你的红尘羁绊太深，雷劫变得格外暴烈。每一道雷光里都有一个人的影子——母亲、师父、道侣——他们不是来阻挡天劫的，是来和你一起扛的。",
        "realm": "golden",
        "weight": 5,
        "path": null,
        "tags": [
