              "seedType": "bloodline",
              "delay": 5,
              "priority": 7
            }
          },
          "right": {
            "text": "拒绝——'我不是殷血'",
            "effects": {
              "daoHeart": 20,
              "karmaGood": 10,
              "health": -15
            },
            "karmaSeed": {
              "id": "demonMasterRefused",
              "seedType": "grudge",
              "delay": 8,
              "priority": 6
            }
          }
        }
      },
      {
        "id": "dp_orthodox_mentor",
        
        "sceneImage":"assets/cards/events/scene_pool_path_choice.png",
        "type": "SPECIAL",
        "title": "白刃真人的托付",
        "description": "白刃真人病倒了——修士不会生病，除非是道伤。他说是年轻时留下的——但你看得出，那伤来自一场和魔道的决斗，对手是殷血。他说：'我不行了——剑道的传承交给你。不要像我一样——在规矩和道心之间选错了方向。'",
        "realm": "golden",
        "weight": 5,
        "path": "sword",
        "tags": [
          "demon_path",
          "act3",
          "master"
        ],
        "requiresFlags": {
          "orthodoxSideChosen": null
        },
        "choices": {
          "left": {
            "text": "接过剑道传承——发誓不辜负",
            "effects": {
              "daoHeart": 25,
              "cultivation": 15,
              "karmaGood": 10,
              "treasure": "白刃剑谱"
            },
            "karmaSeed": {
              "id": "orthodoxDeepBond",
              "seedType": "bloodline",
              "delay": 5,
              "priority": 7
            }
          },
          "right": {
            "text": "'师父——你不会有事的'——去寻找灵药",
            "effects": {
              "daoHeart": 15,
              "karmaGood": 15,
              "fortune": 5,
              "health": -10
            }
          }
        }
      },
      {
        "id": "dp_blood_oath""type": "SPECIAL",
        "title": "血誓",
        "description": "殷血的师父要求你发一个血誓——效忠血煞宗，永不背叛。这是一个不可撤销的誓约——一旦违背，道基必毁。殷血站在旁边，面无表情，但你看得出他的手在微微颤抖——他曾发过同样的誓。",
        "realm": "golden",
        "weight": 5,
        "path": null,
        "tags": [
          "demon_path",
          "act3",
          "oath"
        ],
        "requiresFlags": {
          "demonDeepBond": null
        },
        "choices": {
          "left": {
            "text": "发血誓——'我以道基为誓'",
            "effects": {
              "daoHeart": -15,
              "cultivation": 30,
              "karmaBad": 20
            },
            "desc": "血誓烙在你的丹田上——滚烫、冰冷、不可逆。你感到自己的道被钉在了一个方向上。但你也感到前所未有的力量。"
          },
          "right": {
            "text": "拒绝——'道基是我自己的'",
            "effects": {
              "daoHeart": 20,
              "karmaGood": 10,
              "health": -30,
              "fortune": -15
            },
            "karmaSeed": {
              "id": "bloodOathRefused",
              "seedType": "grudge",
              "delay": 5,
              "priority": 8
            }
          }
        }
      },
      {
        "id": "dp_sect_heirloom""type": "SPECIAL",
        "title": "镇派之宝",
        "description": "白刃真人在你拒绝发血誓的那个夜晚，派人送来了一把剑——剑身上刻着你的名字。这是镇派之宝之一的'问道剑'。附了一行字：'剑道不需要誓约——只需要你的道。'",
        "realm": "golden",
        "weight": 5,
        "path": "sword",
        "tags": [
          "demon_path",
          "act3",
          "heirloom"
        ],
        "requiresFlags": {
          "orthodoxDeepBond": null
        },
        "choices": {
          "left": {
            "text": "握住问道剑——剑鸣如钟",
            "effects": {
              "daoHeart": 30,
              "cultivation": 20,
              "treasure": "问道剑"
            },
            "desc": "剑身发出一声悠长的剑鸣——不是你在驭剑，是剑在认同你。这把剑等了七百年，等到了它认可的人。"
          },
          "right": {
            "text": "将剑送回——'我不配'",
            "effects": {
              "daoHeart": 15,
              "karmaGood": 10
            }
          }
        }
      },
      {
        "id": "dp_demon_schism",
        
        "sceneImage":"assets/cards/events/scene_pool_path_choice.png",
        "type": "SPECIAL",
        "title": "血煞宗的内战",
        "description": "血煞宗内部爆发了内战——血誓派对抗自由派。殷血站在自由派一边——他说：'三百年了，我不想再发一次誓。'但他的师父是血誓派的首领。父子反目——你被要求选边。",
        "realm": "golden",
        "weight": 6,
        "path": null,
        "tags": [
          "demon_path",
          "act3",
          "civil_war"
        ],
        "requiresFlags": {
          "demonInternalConflict": null
        },
        "choices": {
          "left": {
            "text": "站在殷血一边——'自由不该用誓约束缚'",
            "effects": {
              "daoHeart": 15,
              "karmaGood": 10,
              "health": -25
            },
            "karmaSeed": {
              "id": "demonCivilWarChosen",
              "seedType": "bloodline",
              "delay": 4,
              "priority": 7
            }
          },
          "right": {
            "text": "离开——'血煞宗的事与我无关'",
            "effects": {
              "daoHeart": 10,
              "fortune": -10,
              "karmaGood": 5
            }
          }
        }
      },
      {
        "id": "dp_orthodox_schism""type": "SPECIAL",
        "title": "正道的裂痕",
        "description": "正道联盟也不是铁板——天枢道院发现了天道法阵的真相（上界在收割飞升者），要求公开。但其他宗门反对——'这会动摇修真界的根基。'你敬重的白刃真人被迫表态。",
        "realm": "golden",
        "weight": 6,
        "path": null,
        "tags": [
          "demon_path",
          "act3",
          "civil_war",
          "orthodox"
        ],
        "requiresFlags": {
          "orthodoxInternalConflict": null
        },
        "choices": {
          "left": {
            "text": "支持公开真相——'修士有权知道'",
            "effects": {
              "karmaGood": 20,
              "daoHeart": 15,
              "fortune": -15
            }
          },
          "right": {
            "text": "支持维持稳定——'真相会害死更多人'",
            "effects": {
              "daoHeart": -10,
              "karmaBad": 10,
              "fortune": 10
            }
          }
        }
      },
      {
        "id": "dp_demon_redemption""type": "SPECIAL",
        "title": "殷血的救赎",
        "description": "内战到了最残酷的时候——殷血被他的师父亲手重伤，奄奄一息。他躺在血泊里，看着你：'我知道你在正道那边也有人——去告诉白刃，对不起。三万六千剑，我每一剑都后悔。'他闭上了眼睛。",
        "realm": "golden",
        "weight": 5,
        "path": null,
        "tags": [
          "demon_path",
          "act3",
          "redemption",
          "death"
        ],
        "requiresFlags": {
          "demonCivilWarChosen": null
        },
        "choices": {
          "left": {
            "text": "救他——用自己十年修为换他一命",
            "effects": {
              "cultivation": -20,
              "daoHeart": 25,
              "karmaGood": 20,
              "health": -15
            },
            "karmaSeed": {
              "id": "savedYinxue",
              "seedType": "karma",
              "delay": 3,
              "priority": 8
            }
          },
          "right": {
            "text": "让他走——'告诉白刃的人是你自己'",
            "effects": {
              "daoHeart": 10,
              "karmaBad": 15,
              "fortune": 10
            }
          }
        }
      },
      {
        "id": "dp_demon_ascend",
        
        "sceneImage":"assets/cards/events/scene_pool_path_choice.png",
        "type": "SPECIAL",
        "title": "魔道飞升之秘",
        "description": "殷血活了——他告诉你一个秘密：魔道的'飞升'和正道的不一样。魔道的飞升不是被收割——是主动吞噬天道引擎的一部分，用几万年的恶业换来超脱。但你也可以选择：吞噬，或者……炸了它。",
        "realm": "golden",
        "weight": 5,
        "path": null,
        "tags": [
          "demon_path",
          "act3",
          "ascension",
          "revelation"
        ],
        "requiresFlags": {
          "savedYinxue": null
        },
        "choices": {
          "left": {
            "text": "'炸了它——让所有修士都自由'",
            "effects": {
              "daoHeart": 30,
              "karmaGood": 25,
              "fortune": -20
            },
            "karmaSeed": {
              "id": "destroyHeavenEngine",
              "seedType": "fate",
              "delay": 8,
              "priority": 10
            }
          },
          "right": {
            "text": "'吞噬——我不入地狱谁入地狱'",
            "effects": {
              "cultivation": 35,
              "daoHeart": -25,
              "karmaBad": 25
            },
            "karmaSeed": {
              "id": "consumeHeavenEngine",
              "seedType": "fate",
              "delay": 8,
              "priority": 10,
              "cancelGroup": "final_path"
            }
          }
        }
      },
      {
        "id": "dp_final_stand""type": "SPECIAL",
        "title": "最终抉择",
        "description": "天道引擎的核心近在眼前——它的光芒照亮了整个界域。殷血和白刃分别站在你身后——一个浑身是魔纹，一个拄着剑。他们等了三百年，等的是这一刻——不是他们自己的抉择，是你的。",
        "realm": "golden",
        "weight": 5,
        "path": null,
        "tags": [
          "demon_path",
          "act3",
          "finale",
          "world"
        ],
        "requiresFlags": {
          "demonSideChosen": null
        },
        "choices": {
          "left": {
            "text": "破而后立——建立新天道",
            "effects": {
              "daoHeart": 30,
              "karmaGood": 30,
              "cultivation": 20,
              "fortune": 20
            },
            "desc": "你不会重蹈覆辙——新天道没有正道和魔道之分，只有'道'。殷血和白刃同时点了点头——这是他们三百年恩怨中唯一达成的一致。"
          },
          "right": {
            "text": "维持现状——修改天道规则而非推翻",
            "effects": {
              "daoHeart": 15,
              "karmaGood": 15,
              "fortune": 10,
              "cultivation": 15
            },
            "desc": "不是所有错误都需要摧毁——有些需要修正。天道引擎继续运转，但不再收割——而是引导。"
          }
        }
      },
      {
        "id": "dp_refused_revenge",
        
        "sceneImage":"assets/cards/events/scene_pool_path_choice.png",
        "type": "SPECIAL",
        "title": "魔道的报复",
        "description": "你曾经拒绝了殷血的邀请——他没忘记。一群魔修在你最脆弱的时候发动了袭击——不是要杀你，是要让你知道：拒绝魔道不是免费的。",
        "realm": "golden",
        "weight": 0,
        "path": null,
        "tags": [
          "demon_path",
          "karma",
          "revenge"
        ],
        "choices": {
          "left": {
            "text": "迎战——让他们知道你不是好惹的",
            "effects": {
              "cultivation": 15,
              "health": -25,
              "karmaBad": 5
            }
          },
          "right": {
            "text": "智取——用阵法困住他们",
            "effects": {
              "daoHeart": 10,
              "cultivation": 5,
              "fortune": 10
            }
          }
        }
      },
      {
        "id": "dp_accepted_trial""type": "SPECIAL",
        "title": "魔劫",
        "description": "接受魔道修炼的后果来了——魔气反噬，你的丹田出现了裂痕。正道不接纳你，魔道也不完全信任你。你站在两个世界的缝隙里——没有一条路是完全属于你的。",
        "realm": "golden",
        "weight": 0,
        "path": null,
        "tags": [
          "demon_path",
          "karma",
          "trial"
        ],
        "choices": {
          "left": {
            "text": "同时炼化正魔两种力量",
            "effects": {
              "cultivation": 20,
              "daoHeart": 15,
              "health": -25,
              "fortune": -10
            },
            "desc": "你不是第一个尝试的人——大多数都死了。但你感到两种力量在你体内开始融合——不是冲突，是互补。"
          },
          "right": {
            "text": "选择一条路——专心修炼",
            "effects": {
              "daoHeart": 10,
              "cultivation": 10,
              "health": 5
            }
          }
        }
      }
