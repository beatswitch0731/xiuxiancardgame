              "cultivation": 25,
              "fortune": -15,
              "karmaBad": 10
            }
          },
          "right": {
            "text": "毁掉碎片",
            "effects": {
              "karmaGood": 20,
              "daoHeart": 15
            }
          }
        }},
      {
        "id": "k_betrayed_npc""type": "KARMA",
        "title": "破碎的信任",
        "description": "那个曾对你微笑的 NPC 在你背后捅了一刀——不是物理上的。ta把你告诉ta的一个秘密，当成了晋升的筹码。你站在山顶，看着自己最脆弱的部分被当众展示。",
        "realm": "nascent",
        "weight": 0,
        "once": true,
        "tags": [
          "karma",
          "betrayal",
          "npc"
        ],
        "choices": {
          "left": {
            "text": "以直报怨",
            "effects": {
              "daoHeart": 15,
              "karmaBad": 10,
              "cultivation": 10
            }
          },
          "right": {
            "text": "以德报怨",
            "effects": {
              "karmaGood": 25,
              "daoHeart": 20,
              "cultivation": -5
            }
          }
        },
        "sceneImage": "assets/cards/events/scene_karma_k_betrayed_npc.png"
      },
      {
        "id": "k_echo_past_life""type": "KARMA",
        "title": "前世回响",
        "description": "一阵晕眩——你看到了前世最后一刻的画面。那是一座血色弥漫的山门，一个你不认识却无比熟悉的背影。那个人的道和你截然不同，但你看到他倒下的时候，你的心也跟着痛了。\n\n你低头看着自己的手——这不是你的第一双手。你活过，死过，又活了。前世的记忆如碎裂的镜子一样扎在你的识海里——无法完整拼凑，却也无法抹去。\n\n一个老者路过，看了你一眼，意味深长地说：'年轻人——你的眼神，不像只有一世的人。'",
        "choices": {
          "left": {
            "text": "追寻前世记忆",
            "effects": {
              "daoHeart": 10,
              "cultivation": 5,
              "fortune": -5
            }
          },
          "right": {
            "text": "放下——此生即是此生",
            "effects": {
              "daoHeart": 15,
              "fortune": 5
            }
          }
        },
        "realm": "qi,foundation,golden",
        "requirements": {
          "minLifeCount": 1
        },
        "priority": 35},
      {
        "id": "k_echo_path_mastery""type": "KARMA",
        "title": "功法记忆",
        "description": "你的手指不由自主地掐了一个剑诀——不，你此生是法修，但你前世是剑修。那股剑意像深埋在地下的古铜器，被岁月锈蚀却依旧在。\n\n你试着运转法力——指尖划过空气的轨迹竟然无意间画出了一道剑罡。虽然微弱，却真实存在。\n\n一个念头在你脑海中闪现：前世的功法，也许不是完全消失了。",
        "choices": {
          "left": {
            "text": "融合前世剑意",
            "effects": {
              "cultivation": 10,
              "daoHeart": 3,
              "health": -3
            }
          },
          "right": {
            "text": "专注此世之道",
            "effects": {
              "daoHeart": 8,
              "cultivation": 3,
              "fortune": 3
            }
          }
        },
        "realm": "foundation,golden,nascent",
        "requirements": {
          "minLifeCount": 2,
          "differentPaths": true
        },
        "priority": 35,
        "sceneImage": "assets/cards/events/scene_karma_k_echo_path_mastery.png"
      },
      {
        "id": "k_echo_karma_chain""type": "KARMA",
        "title": "三世因果",
        "description": "你站在一座废弃的道观前——道观的石门上刻着三个名字。第一个是你第一世的名字，第二个是你上一世的名字，第三个——是空白的。\n\n一个老道士推开了道观的门，他看起来眼熟——不是认识，是'前世认识'。他说：'你来了。三世了——你还不知道自己在修的到底是什么道吗？'\n\n他递给你一面古镜。镜子里不是你的脸——是你每一世死亡时的最后一个表情。你看到自己——三张不同的脸上，是一样的不甘心。",
        "choices": {
          "left": {
            "text": "我要找到真正的道",
            "effects": {
              "daoHeart": 20,
              "cultivation": 10,
              "fortune": 5,
              "karmaGood": 10
            }
          },
          "right": {
            "text": "道即是活着——活下去就是道",
            "effects": {
              "health": 15,
              "cultivation": 10,
              "karmaBad": 5
            }
          }
        },
        "realm": "golden,nascent,deity",
        "requirements": {
          "minLifeCount": 3
        },
        "priority": 40},
      {
        "id": "k_sword_legacy_start""type": "KARMA",
        "title": "心剑初成·回响",
        "description": "自从你用心念铸成了第一把心剑，剑冢里的古剑们就开始认你——它们在你路过时发出轻微的共鸣。剑冢的守卫老头拦住你，把一块玉符塞进你手心：'这是剑祖的遗物。它在发热——自从你来了之后。'",
        "realm": "golden",
        "weight": 0,
        "once": true,
        "tags": [
          "karma",
          "sword",
          "legacy"
        ],
        "choices": {
          "left": {
            "text": "接下玉符，感受剑祖意志",
            "effects": {
              "daoHeart": 20,
              "cultivation": 15,
              "fortune": 5
            }
          },
          "right": {
            "text": "让守卫归还剑冢",
            "effects": {
              "karmaGood": 15,
              "daoHeart": 10
            }
          }
        },
        "sceneImage": "assets/cards/events/scene_karma_k_sword_legacy_start.png"
      },
      {
        "id": "k_sword_legacy_trial""type": "KARMA",
        "title": "剑道最终试炼",
        "description": "剑冢深处——一把没有剑身的剑柄悬浮在空中。它在等你。白刃真人站在旁边，沉默如剑。\n\n剑柄上的铭文写着：'执此剑者，持一颗无剑之心；无剑之心，天下皆可为剑。'\n\n你握住了它——剑身从你的道心中生长出来，由纯粹的意念凝聚，无形却锋利至极。这就是传说中的'道剑'。",
        "realm": "nascent",
        "weight": 0,
        "once": true,
        "tags": [
          "karma",
          "sword",
          "ultimate"
        ],
        "choices": {
          "left": {
            "text": "以道剑开辟新剑道",
            "effects": {
              "daoHeart": 30,
              "cultivation": 20,
              "fortune": 15
            }
          },
          "right": {
            "text": "将道剑传给最值得的人",
            "effects": {
              "karmaGood": 25,
              "daoHeart": 20,
              "cultivation": 10
            }
          }
        }},
      {
        "id": "k_sword_legacy_echo""type": "KARMA",
        "title": "剑道传承·尾声",
        "description": "剑道传承完成很久之后——你发现自己的剑意开始影响周围的年轻修士。有一个少年，剑法烂得出奇，但他握剑的方式和你当年一模一样。\n\n他问你：'前辈，什么是剑道？'\n\n你看着他，想起了白刃真人看你时的那个眼神。",
        "realm": "nascent",
        "weight": 0,
        "once": true,
        "tags": [
          "karma",
          "sword",
          "mentor",
          "legacy"
        ],
        "choices": {
          "left": {
            "text": "收他为徒，传剑道",
            "effects": {
              "karmaGood": 20,
              "daoHeart": 25,
              "fortune": 10
            }
          },
          "right": {
            "text": "让他自己去找答案",
            "effects": {
              "daoHeart": 15,
              "cultivation": 15
            }
          }
        },
        "sceneImage": "assets/cards/events/scene_karma_k_sword_legacy_echo.png"
      },
      {
        "id": "k_spell_codex_start""type": "KARMA",
        "title": "禁术初启·余震",
        "description": "自从你学了禁术基础，你的手指在无意间会划出一些奇怪的符文——不是你学过的任何法术。太古法修的记忆碎片开始浮现：一个盛大的法阵、无数法修的元婴燃烧发光、以及上界狰狞的笑脸。\n\n慕青岚看到你指尖的符文，脸色大变。'你看到了多少？'",
        "realm": "golden",
        "weight": 0,
        "once": true,
        "tags": [
          "karma",
          "spell",
          "forbidden"
        ],
        "choices": {
          "left": {
            "text": "告诉她你看到的一切",
            "effects": {
              "daoHeart": 15,
              "fortune": -10,
              "karmaGood": 10
            }
          },
          "right": {
            "text": "只说了一部分",
            "effects": {
              "cultivation": 15,
              "daoHeart": -5
            }
          }
        }},
      {
        "id": "k_spell_codex_refused""type": "KARMA",
        "title": "契约的报复",
        "description": "你拒绝了虚空深处那个东西的契约。\n\n三个月后，它来找你算账了——不是直接现身，而是悄悄侵蚀你的识海边缘。你在修炼时看到了它的影子，听到了它的声音：'你以为封印能挡住我多久？'\n\n玄机真人告诉你：唯一能彻底断开这条联系的方法，是用道心的火焰烧掉那个裂缝。但那个代价——是一段记忆。",
        "realm": "nascent",
        "weight": 0,
        "once": true,
        "tags": [
          "karma",
          "spell",
          "horror",
          "choice"
        ],
        "choices": {
          "left": {
            "text": "用道心之火烧掉裂缝——哪段记忆，就哪段",
            "effects": {
              "daoHeart": 30,
              "fortune": -15,
              "karmaGood": 15
            }
          },
          "right": {
            "text": "继续与它周旋——保留记忆",
            "effects": {
              "cultivation": 20,
              "daoHeart": -20,
              "karmaBad": 10
            }
          }
        },
        "sceneImage": "assets/cards/events/scene_karma_k_spell_codex_refused.png"
      },
      {
        "id": "k_spell_codex_echo""type": "KARMA",
        "title": "禁术之书·后记",
        "description": "禁术之书的封印最终彻底稳固了——太古法修的残魂消散，万卷楼恢复了平静。\n\n但慕青岚找到你，递给你一卷手抄——那是她亲手抄录的太古法修在被封印之前留下的最后几页心得。\n\n她说：'他不是坏人。只是走了一条没有人能陪他走完的路。'\n\n你看着那几页字——它们是你见过的最孤独的文字。",
        "realm": "golden",
        "weight": 0,
        "once": true,
        "tags": [
          "karma",
          "spell",
          "companion",
          "epilogue"
        ],
        "choices": {
          "left": {
            "text": "研读心得，踏上他未走完的路",
            "effects": {
              "cultivation": 20,
              "daoHeart": 15,
              "karmaBad": 5
            }
          },
          "right": {
            "text": "将心得永久封存于万卷楼",
            "effects": {
              "karmaGood": 20,
              "daoHeart": 20,
              "fortune": 5
            }
          }
        }},
      {
        "id": "k_pill_master_start""type": "KARMA",
        "title": "因果丹的后效",
        "description": "大量炼制因果丹之后，你发现自己对因果的感知变得异常敏锐——你能看到人与人之间的因果丝线，金色的、红色的、黑色的。\n\n药圣说这是'丹眼'开启，是丹修中最罕见的天赋。他的声音里有说不清的复杂情绪——'我炼了三百年丹，从没开过丹眼。你炼了几个月。'",
        "realm": "golden",
        "weight": 0,
        "once": true,
        "tags": [
          "karma",
          "pill",
          "talent"
        ],
        "choices": {
          "left": {
            "text": "运用丹眼感知天地因果",
            "effects": {
              "fortune": 20,
              "daoHeart": 10,
              "cultivation": 10
            }
          },
          "right": {
            "text": "收敛丹眼——看多了太沉重",
            "effects": {
              "daoHeart": 20,
              "karmaGood": 10
            }
          }
        },
        "sceneImage": "assets/cards/events/scene_karma_k_pill_master_start.png"
      },
      {
        "id": "k_pill_master_sacrifice""type": "KARMA",
        "title": "毁丹之后",
        "description": "你毁掉了因果丹的那一刻，五粒丹的因果力量炸裂开来——化作一场金色的雨，落在了神农丹谷方圆百里的土地上。\n\n三天后，谷中的草药疯长。一株已经枯死的万年雪莲重新开花。药圣站在莲前，哭了——这是他三百年来第一次落泪。\n\n他说：'你毁的不是丹——是一道天道试题。答案是，人情比天道值钱。'",
        "realm": "nascent",
        "weight": 0,
        "once": true,
        "tags": [
          "karma",
          "pill",
          "sacrifice",
          "revelation"
        ],
        "choices": {
          "left": {
            "text": "采下雪莲，炼最后一粒丹",
            "effects": {
              "cultivation": 20,
              "daoHeart": 20,
              "pill": "万年雪莲丹"
            }
          },
          "right": {
            "text": "让雪莲继续开着——不炼了",
            "effects": {
              "karmaGood": 30,
              "daoHeart": 25,
              "fortune": 10
            }
          }
        }},
      {
        "id": "k_pill_master_echo""type": "KARMA",
        "title": "丹道宗师·尾声",
        "description": "失传丹方的故事在修真界悄悄流传——没有人知道完整的版本，但'有人炼出了三千年前失传的因果丹'这件事，被写进了神农丹谷的年志。\n\n药圣在临终前把你叫到床前，把他手里那本《因果丹经》递给了你。\n\n封底有一行字，是他今天才写的：'此书传予那个比我更疯的家伙——但比我更有资格。'",
        "realm": "golden",
        "weight": 0,
        "once": true,
        "tags": [
          "karma",
          "pill",
          "mentor",
          "legacy"
        ],
        "choices": {
          "left": {
            "text": "接过丹经，继承药圣之道",
            "effects": {
              "cultivation": 15,
              "daoHeart": 30,
              "fortune": 10
            }
          },
          "right": {
            "text": "将丹经捐给神农丹谷",
            "effects": {
              "karmaGood": 25,
              "daoHeart": 20
            }
          }
        },
        "sceneImage": "assets/cards/events/scene_karma_k_pill_master_echo.png"
      }
    ]
  },
  "cards:demonic_seductress": {
    "_desc": "魔道女修事件 — 以色换资源的诱惑性遭遇",
    "cards": [
      {
        "id": "ds_blood_moon",
        
        "sceneImage":"assets/cards/events/scene_pool_story_moment.png",
        "type": "NPC_ENCOUNTER",
        "title": "血月之下",
        "description": "血月之夜，你在一处荒废矿洞中遇见一位血煞宗女修。她靠在矿壁上，衣襟微敞——锁骨处有一道旧剑伤。'你是正道的？别怕——我现在不想杀人。只想……讨口吃的。'她的血煞灵气很弱了，似乎刚经历过一场恶战。",
        "realm": "foundation",
        "npcId": "ds_bloodrose",
        "npcName": "血玫",
        "choices": {
          "left": {
            "text": "给她灵石买药（-30 灵石）",
            "effects": {
              "spiritStone": -30,
              "karmaGood": 8
            },
            "npcAffection": 15
          },
          "right": {
            "text": "既然落难——不如让本座尝尝血煞宗的滋味",
            "effects": {
              "cultivation": 10,
              "karmaBad": 15,
              "health": 5
            },
            "npcAffection": 8,
            "narrativeBlock": "你走近她。她抬头看着你，血瞳中闪过一丝惊讶——然后是她先动了。她的手指冰凉，但唇是烫的。",
            "_adultThemes": true
          }
        }
      },
      {
        "id": "ds_moon_lake",
        "type": "NPC_ENCOUNTER",
        "title": "月湖妖女",
        "description": "月湖深处雾气氤氲，你听到水声。拨开芦苇——一位妖修女子正在湖中洗浴。她发现了你，但并未惊慌，反而弯起嘴角：'好看吗？好看的话——拿你身上那颗筑基丹来换。'她的眼神很坦率——妖族从来不说假话。",
        "realm": "golden",
        "npcId": "ds_moonmist",
        "npcName": "月烟",
        "choices": {
          "left": {
            "text": "转身离开",
            "effects": {
              "daoHeart": 8,
              "karmaGood": 5
            }
          },
          "right": {
            "text": "交出筑基丹——留下看个够",
            "effects": {
              "cultivation": -10,
              "karmaBad": 10,
              "daoHeart": -5
            },
            "pillCost": {
              "foundation": 1
            },
            "npcAffection": 20,
            "narrativeBlock": "她接过丹药，然后慢慢从水中起身。水珠从她肩头滑下——月光替她穿了衣裳。'交易就是交易。这枚筑基丹——值这个价。'",
            "_adultThemes": true
          }
        }
      },
      {
        "id": "ds_spirit_vein",
        "type": "NPC_ENCOUNTER",
        "title": "灵脉之女",
        "description": "你在灵脉核心发现一位半裸的女子——她的身体与灵脉藤蔓缠绕在一起。她睁眼看向你，眼中流动的居然是纯粹的灵光。'我在这里困了七百年。凡人——用你的灵力喂我，我许你突破金丹。'她的声音如泉水击石——不像是请求，更像是开价。",
        "realm": "golden",
        "npcId": "ds_spiritvine",
        "npcName": "灵萝",
        "choices": {
          "left": {
            "text": "用修为喂她（损失修为，突破金丹成功率+20%）",
            "effects": {
              "cultivation": -25,
              "daoHeart": 10
            },
            "breakBoost": {
              "realm": "golden",
              "amount": 0.2
            }
          },
          "right": {
            "text": "解她藤蔓——以身体接触传灵力",
            "effects": {
              "cultivation": 15,
              "karmaBad": 8,
              "daoHeart": -5
            },
            "narrativeBlock": "你握住她的手。灵力通过掌心传递，藤蔓缓缓松开——她的手很软，像从未握过兵器。她靠在你的胸前喘息，灵光从她皮肤下透出，照亮了你的脸。",
            "_adultThemes": true
          }
        }
      },
      {
        "id": "ds_demonic_auction",
        
        "sceneImage":"assets/cards/events/scene_pool_path_choice.png",
        "type": "NORMAL",
        "title": "魔道拍卖·炉鼎",
        "description": "魔道地下拍卖会上，一件特殊的'拍卖品'被推出来——不是法宝，而是一位被封印修为的魔道女修。她目光扫过全场，最后停在你脸上。'你是正道的。我知道。但我也知道——你口袋里有灵石。买下我，我比任何炉鼎都有用。'",
        "realm": "nascent",
        "choices": {
          "left": {
            "text": "出价买下她（-100 灵石，获得道侣）",
            "effects": {
              "spiritStone": -100,
              "karmaGood": 5,
              "karmaBad": 5
            },
            "companion": "ds_demoness",
            "npcAffection": 20
          },
          "right": {
            "text": "不参与魔道交易",
            "effects": {
              "daoHeart": 10,
              "karmaGood": 10
            }
          }
        }
      },
      {
        "id": "ds_demoness_serve",
        
        "sceneImage":"assets/cards/events/scene_pool_story_moment.png",
        "type": "COMPANION_EVENT",
        "title": "魔女报恩",
        "description": "你买下的魔道女修——她在你洞府里住了三天。第四天晚上她推开你的门，身上只披着一件外袍。'你不像其他正道修士那样看轻我。让我报答你——用我的方式。'她的手指轻轻搭在你肩上，指尖冰凉但坚定。",
        "realm": "nascent",
        "npcId": "ds_demoness",
        "requiresFlag": "companion_ds_demoness_acquired",
        "choices": {
          "left": {
            "text": "接受她——让她做道侣",
            "effects": {
              "daoHeart": -10,
              "karmaBad": 10
            },
            "companionEffects": {
              "affection": 30,
              "bondDelta": 1
            },
            "narrativeBlock": "你没有推开她。烛火熄了——但她身上的魔纹在黑暗中发着暗红色的光。那些纹路是你见过最美的地图，每一寸都是故事。",
            "_adultThemes": true
          },
          "right": {
            "text": "给她自由——你可以走了",
            "effects": {
              "daoHeart": 10,
              "karmaGood": 15
            }
          }
        }
      },
      {
        "id": "ds_demoness_dual",
        
        "sceneImage":"assets/cards/events/scene_pool_story_moment.png",
        "type": "COMPANION_EVENT",
        "title": "正魔双修",
        "description": "她站在你的蒲团前，双手结印——正道的灵气和魔道的煞气在她掌心中融合。'我找到了方法。正道和魔道不用二选一——我们可以一起。过来——把你的手给我。'她的眼眸中跳动着两团火焰——一白一红。",
        "realm": "deity",
        "npcId": "ds_demoness",
        "requiresFlag": "companion_ds_demoness_bonded",
        "choices": {
          "left": {
            "text": "握住她的手——正魔双修",
            "effects": {
              "cultivation": 30,
              "daoHeart": 5,
              "karmaBad": 5
            },
            "companionEffects": {
              "affection": 20
            },
            "narrativeBlock": "双手交汇的瞬间——你的灵气和她身上的魔纹同时炸开。灼热的灵气冲刷着你的每一条经脉。她的额头抵在你的额头上——你们在那一刻看到了彼此的前世。'原来是你。'她轻声说。",
            "_adultThemes": true
          },
          "right": {
            "text": "拒绝——正魔不该同修",
            "effects": {
              "daoHeart": 15,
              "karmaGood": 10
            }
          }
        }
      },
      {
        "id": "ds_demoness_night",
        
        "sceneImage":"assets/cards/events/scene_pool_story_moment.png",
        "type": "COMPANION_EVENT",
        "title": "魔纹之夜",
        "description": "魔纹在月光下会发光——这是你和她共同的秘密。她让你用指尖描摹她背上的魔纹——那是她被封印时留下的烙印。每描一条，她就轻轻颤一次。'再描一遍。'她趴在石床上，把脸埋在枕头上——声音闷闷的，但耳朵都红了。",
        "realm": "deity",
        "npcId": "ds_demoness",
        "requiresFlag": "companion_ds_demoness_intimate",
        "choices": {
          "left": {
            "text": "继续描下去——一夜缱绻",
            "effects": {
              "daoHeart": 15,
              "karmaBad": 5
            },
            "companionEffects": {
              "affection": 25,
              "bondDelta": 1
            },
            "narrativeBlock": "你的指尖沿着魔纹缓缓滑下。她的身体像一张绷紧的弓——每一寸魔纹都因你的触碰而亮起暗红的光。天快亮时，她转过身来，第一次没有对你露出任何防备。",
            "_adultThemes": true
          },
          "right": {
            "text": "停下——这样就好",
            "effects": {
              "daoHeart": 10
            },
            "companionEffects": {
              "affection": 10
            }
          }
        }
      },
      {
        "id": "ds_temptation_inn",
        "type": "NPC_ENCOUNTER",
        "title": "客栈艳遇",
        "description": "投宿客栈时，隔壁房间传来轻声呼唤。一位受伤的女修靠在你的门口，衣衫不整——她说是被仇家追杀至此，求借宿一夜。她的眼神在月光下流转，手指若有若无地擦过你的手臂。'公子——一夜就好。明日我就离开。'",
        "realm": "foundation",
        "npcId": "ds_traveler",
        "npcName": "柳如烟",
        "choices": {
          "left": {
            "text": "借她一晚厢房——自己守在门外",
            "effects": {
              "daoHeart": 5,
              "karmaGood": 8
            },
            "npcAffection": 10
          },
          "right": {
            "text": "让她进来——良宵难再",
            "effects": {
              "cultivation": 5,
              "karmaBad": 10,
              "daoHeart": -5
            },
            "npcAffection": 15,
            "narrativeBlock": "她进门时带进一阵混合着血和茉莉花香的风。翌日她走了——只在枕上留下一枚茉莉花钿。你的修为确实涨了一点。但丹田里似乎多了一缕不属于你的灵气。",
            "_adultThemes": true
          }
        }
      },
      {
        "id": "ds_pill_master_trade""type": "NORMAL",
        "title": "丹房春色",
        "description": "丹修坊市的女修士拉着你的袖子，把你拽进她的丹房。'帮我看一炉九转还魂丹——我一个人守不住这火候。报酬就是——你需要什么？灵石？丹药？还是……别的东西？'她边说边解开外袍——丹房里确实很热。",
        "realm": "nascent",
        "npcId": "ds_alchemist",
        "npcName": "丹朱",
        "choices": {
          "left": {
            "text": "只要灵石报酬（+50 灵石）",
            "effects": {
              "spiritStone": 50,
              "daoHeart": 3
            }
          },
          "right": {
            "text": "看看那'别的东西'是什么",
            "effects": {
              "cultivation": 15,
              "karmaBad": 8
            },
            "narrativeBlock": "她轻笑了一声——然后是一整夜的丹火明灭。炉中的九转还魂丹成了，而你丹田里也添了一股暖流。她塞给你一瓶金丹：'下次还来——我还有很多丹药要炼。'",
            "_adultThemes": true
          }
        }
      },
      {
        "id": "ds_female_bandit",
        
        "sceneImage":"assets/cards/events/scene_pool_dungeon_cave.png",
        "type": "DUNGEON",
        "title": "女匪寨",
        "description": "你被一群女修匪徒劫上山寨。为首的坐在虎皮椅上，翘着二郎腿看你。'细皮嫩肉的公子哥——知道抢了你值多少灵石吗？不过……你倒是不怕。有意思。给老娘说说——你是来剿匪的，还是来……别的？'她笑了起来，笑声在山寨中回荡。",
        "realm": "golden",
        "npcId": "ds_bandit_queen",
        "npcName": "虎娘",
        "choices": {
          "left": {
            "text": "亮剑——剿灭山寨",
            "effects": {
              "cultivation": 10,
              "karmaGood": 10
            }
          },
          "right": {
            "text": "坐下喝酒——看看她想干什么",
            "effects": {
              "cultivation": 8,
              "karmaBad": 5
            },
            "npcAffection": 12,
            "narrativeBlock": "酒过三巡。虎皮从她肩上滑下，她索性不管了。'修了三十年仙，头一次遇到不怕我的正道。你比那些假正经的强——今晚别走了。'山寨里的篝火烧了一整夜。",
            "_adultThemes": true
          }
        }
      }
    ]
  },
  "npcs:core": {
    "npcs": [
      {
        "id": "bai_ren",
        
        "sceneImage":"assets/cards/events/scene_pool_sect_training.png",
        "name": "白刃真人",
        "title": "青云剑宗掌门",
        "personality": {
          "benevolence": 55,
          "proud": 80,
          "persistence": 85,
          "affection": 30,
          "courage": 70
        },
        "appearRealms": [
          "qi",
          "foundation",
          "golden",
          "nascent",
          "deity",
          "tribulation"
        ],
        "pathRestriction": "sword",
        "defaultEmotion": "平静",
        "defaultMindset": "执念",
        "defaultLocation": "青云剑宗·剑冢",
        "startAffection": 0,
        "startTrust": 10,
        "teachable": true,
        "firstMeeting": "你拜入青云剑宗，白刃真人看了你的剑一眼，只说了四个字：剑出无悔。",
        "secrets": [
          {
            "level": 1,
            "text": "白刃喜欢喝东海醉仙酿——虽然嘴上从来不说。"
          },
          {
            "level": 2,
            "text": "师弟血煞老祖是他一生之痛。他们曾经是青云最好的师兄弟。"
          },
          {
            "level": 3,
            "text": "剑冢仙剑是上界监视器。白刃一直在找毁掉仙剑的方法。"
          }
        ],
        "giftPrefs": {
          "love": [
            "醉仙酿",
            "上古剑谱"
          ],
          "like": [
            "磨剑石",
            "剑穗",
            "灵茶"
          ],
          "hate": [
            "法宝",
            "华丽装饰"
          ]
        },
        "gossipTopics": [
          "正魔大战可能在三年内爆发——魔道三宗最近动作频频。",
          "天机阁最近似乎发现了什么——天机老人已经一个月没出关了。",
          "北荒那边有异象——听说有人在冰原深处看到了一座城池。"
        ],
        "knownInfo": [
          {
            "text": "剑冢深处有一柄上古仙剑——但没人能拔出。",
            "requiredAffection": 0
          },
          {
            "text": "白刃曾经有一个师弟，叛出了青云剑宗。",
            "requiredAffection": 30
          },
          {
            "text": "那个师弟如今是血煞宗宗主——血煞老祖。",
            "requiredAffection": 60
          },
          {
            "text": "血煞老祖叛出师门不是因为野心——是因为发现了仙剑的秘密。",
            "requiredAffection": 80
          }
        ],
        "schedule": {
          "子时": "青云剑宗·剑冢",
          "寅时": "青云剑宗·剑冢",
          "辰时": "青云剑宗·宗门大殿",
          "午时": "青云剑宗·演武场",
          "申时": "青云剑宗·闭关室",
          "戌时": "青云剑宗·山门"
        },
        "dialogues": [
          {
            "scene": "初见",
            "minAffection": 0,
            "mindset": "通明",
            "text": "你叫……（看了你的剑一眼）剑骨尚可。从今日起，你就是青云弟子。记住一句话——剑出无悔。"
          },
          {
            "scene": "修炼",
            "minAffection": 20,
            "maxAffection": 49,
            "text": "你的剑路太直了。正道教的剑法循规蹈矩，但真正的剑——是活的。去剑冢，跟那些残剑学学。"
          },
          {
            "scene": "修炼",
            "minAffection": 50,
            "maxAffection": 79,
            "text": "今天你的剑快了半寸。但快不是一切——你出剑的时候，在想什么？没想？那就对了。想得太多，剑就重了。"
          },
          {
            "scene": "修炼",
            "minAffection": 80,
            "text": "（罕见地露出一丝笑意）你这一剑……有点老夫当年的样子。别得意——老夫当年也输过。"
          },
          {
            "scene": "闲聊",
            "minAffection": 0,
            "maxAffection": 79,
            "mindset": "执念",
            "text": "（面色一沉）不关你的事。回去练剑。"
          },
          {
            "scene": "闲聊",
            "minAffection": 80,
            "mindset": "执念",
            "text": "（长久的沉默）他叫陆沉舟。曾经……是青云最好的剑。后来他发现了剑冢的秘密，选择了一条我不认同的路。但我至今不知道——他是对的还是错的。"
          },
          {
            "scene": "请教",
            "minAffection": 15,
            "text": "白刃真人出剑示范，剑光如雪。他只出了一剑，但你悟了十种变化。"
          },
          {
            "scene": "论道",
            "minAffection": 30,
            "text": "'剑道的极致是什么？'白刃真人问，然后自答：'不是快，不是强——是无悔。你出剑的那一刻，天也不能改。'"
          },
          {
            "scene": "通用",
            "minAffection": 0,
            "text": "白刃真人站在剑冢入口，手负长剑，望向远方。他没有说话，但你知道他在。"
          }
        ]
      },
      {
        "id": "bai_luoxuan",
        
        "sceneImage":"assets/cards/events/scene_pool_sect_training.png",
        "name": "白落霜",
        "title": "白狐部·报恩者",
        "personality": {
          "benevolence": 75,
          "proud": 35,
          "persistence": 60,
          "affection": 90,
          "courage": 45
        },
        "appearRealms": [
          "foundation",
          "golden",
          "nascent",
          "deity",
          "tribulation"
        ],
        "defaultEmotion": "平静",
        "defaultMindset": "通明",
        "defaultLocation": "南疆·白狐部",
        "startAffection": 20,
        "startTrust": 30,
        "teachable": true,
        "firstMeeting": "她站在你的洞府门口，白衣银发，傍晚的光从背后透过她的发丝。'恩公——奴家白落霜，今日特来报恩。'",
        "giftPrefs": {
          "love": [
            "南疆野花",
            "狐牙项链"
          ],
          "like": [
            "灵药",
            "丝织物",
            "参汤材料"
          ],
          "hate": [
            "剑",
            "符箓"
          ]
        },
        "secrets": [
          {
            "level": 1,
            "text": "她其实每天都会在你闭关的洞府外守一个时辰——等你出来喝参汤。"
          },
          {
            "level": 2,
            "text": "白狐部的狐牙是定情信物。她一直带着自己那颗——在等你送她第二颗。"
          },
          {
            "level": 3,
            "text": "她是九尾天狐的后裔。当年太古浩劫中，九尾一族被天道诅咒——若与人族结为道侣，将失去长生。"
          }
        ],
        "gossipTopics": [
          "南疆深处的太古遗迹最近有异动——各大势力都在派人探查。",
          "白狐部的灵药采了三十年才长成一批——妖族的寿命让他们的耐心远超人族。",
          "九尾大人在月湖边见过你。她说你的命格——'有意思'。"
        ],
        "knownInfo": [
          {
            "text": "白狐部居住在南疆深处，与世无争。",
            "requiredAffection": 0
          },
          {
            "text": "她的参汤用了妖族独有的火候——三十年才能练成的手艺。",
            "requiredAffection": 30
          },
          {
            "text": "白狐的记忆可以传三百年。她在试图把和你的记忆传下去。",
            "requiredAffection": 60
          },
          {
            "text": "她是九尾天狐的血脉。与你结为道侣，意味着放弃长生。",
            "requiredAffection": 80
          }
        ],
        "dialogueScenes": [
          "闲聊",
          "修炼",
          "危机",
          "表白",
          "离别",
          "赠礼",
          "通用"
        ],
        "dialogues": [
          {
            "scene": "初见",
            "minAffection": 0,
            "text": "（虚弱地躺在草丛里）她只是看着你，琥珀色的眼睛里没有恐惧，只有疑惑。"
          },
          {
            "scene": "修炼",
            "minAffection": 30,
            "maxAffection": 60,
            "text": "'道侣，你今天闭关太久了。我给你煮了参汤——不喝就凉了。'碗里的参汤还是热的——她已经热了三次了。"
          },
          {
            "scene": "修炼",
            "minAffection": 70,
            "text": "'你修炼的时候……我能坐在旁边吗？不打扰。就是想看着。白狐的记忆可以传三百年。三百年后，我希望我记得的——是你在修炼时的侧脸。'"
          },
          {
            "scene": "闲聊",
            "minAffection": 40,
            "text": "'这片山上的灵药我都认识。这株是金线莲，这个是九节菖蒲……你问为什么知道？白狐部的族人从出生就在南疆采药——这是本能。'"
          },
          {
            "scene": "危机",
            "minAffection": 60,
            "text": "'道侣……他们在说的那些话，我都听到了。'她的声音很轻。'他们说人妖殊途……你别生气，我不在意。'但她握着你的手紧了一些。"
          },
          {
            "scene": "表白",
            "minAffection": 80,
            "text": "'道侣，如果我的存在让你为难……我可以走。白狐的记忆可以传三百年。三百年后，这世上还有人记得你的模样——就够了。'"
          },
          {
            "scene": "赠礼",
            "minAffection": 50,
            "text": "'这是……南疆白狐部的狐牙？'她接过项链，手指微微发抖。'你知道狐牙对白狐部意味着什么吗……这是定情信物。'"
          },
          {
            "scene": "通用",
            "minAffection": 0,
            "text": "白落霜坐在石桌旁，双手托腮看着你。她的尾巴在身后轻轻摇摆。"
          }
        ]
      },
      {
        "id": "jian_linger",
        
        "sceneImage":"assets/cards/events/scene_pool_sect_training.png",
        "name": "剑灵儿",
        "title": "青云剑宗·白刃关门弟子",
        "personality": {
          "benevolence": 60,
          "proud": 85,
          "persistence": 75,
          "affection": 30,
          "courage": 90
        },
        "appearRealms": [
          "foundation",
          "golden",
          "nascent",
          "deity",
          "tribulation"
        ],
        "pathRestriction": "sword",
        "defaultEmotion": "平静",
        "defaultMindset": "执念",
        "defaultLocation": "青云剑宗·剑冢",
        "startAffection": 0,
        "startTrust": 5,
        "teachable": true,
        "firstMeeting": "'你就是师尊新收的弟子？'她抱着剑靠在剑冢的石壁上，眼神从上扫到下。'看起来……一般。来，拔剑。'",
        "giftPrefs": {
          "love": [
            "名剑",
            "亲手磨的剑"
          ],
          "like": [
            "修炼心得",
            "冰属性丹药",
            "剑穗"
          ],
          "hate": [
            "脂粉",
            "华丽衣物"
          ]
        },
        "secrets": [
          {
            "level": 1,
            "text": "她其实很在意自己看起来不够\"女人味\"——所以最讨厌收脂粉当礼物。"
          },
          {
            "level": 2,
            "text": "她的冰心剑意是在心魔劫中悟出的——那年她差点走火入魔，是白刃真人以命换命才把她拉回来。"
          },
          {
            "level": 3,
            "text": "她对你用的剑路特意放慢了半拍——怕伤到你。白刃真人说她练剑七十年，从没对任何人留过手。"
          }
        ],
        "gossipTopics": [
          "师尊最近老往剑冢深处跑——那里是不是有机关连着我们不知道的东西？",
          "上次论剑大会后，古剑派铁剑翁的脸色可精彩了——师尊一剑就让他闭了嘴。",
          "那个殷血……他来过剑冢。师尊没出手。我不知道为什么。"
        ],
        "knownInfo": [
          {
            "text": "剑灵儿是白刃真人唯一的关门弟子——她用七十年证明了师尊没有看走眼。",
            "requiredAffection": 0
          },
          {
            "text": "她每天在剑冢练剑四个时辰。风雨无阻——不是勤奋，是把练剑当呼吸。",
            "requiredAffection": 30
          },
          {
            "text": "她的冰心剑意在心魔劫中悟出。白刃真人用自己一半修为换她活着。",
            "requiredAffection": 60
          },
          {
            "text": "她对你出剑时慢了半拍。七十年来第一次——白刃真人说她开窍了，但不是剑窍。",
            "requiredAffection": 80
          }
        ],
        "dialogues": [
          {
            "scene": "初见",
            "minAffection": 0,
            "text": "'三招之内你还能站着，就算我认你这个师弟。'"
          },
          {
            "scene": "修炼",
            "minAffection": 20,
            "maxAffection": 49,
            "text": "'你的第三剑……方向对了，太慢了。下次快半寸。'"
          },
          {
            "scene": "修炼",
            "minAffection": 50,
            "maxAffection": 79,
            "text": "你的剑……最近有点不一样。少了戾气，多了点……我也说不上来。谁教的？——不准说是我师尊。"
          },
          {
            "scene": "修炼",
            "minAffection": 80,
            "text": "'你……今天怎么没来练剑？（顿了顿）不是关心你——是没人陪我切磋！'"
          },
          {
            "scene": "闲聊",
            "minAffection": 50,
            "mindset": "执念",
            "text": "'那个魔修？你怎么会认识他……算了。我不问了。'但她握剑的指节发白了。"
          },
          {
            "scene": "请教",
            "minAffection": 15,
            "text": "剑灵儿随手一挥，剑尖凝出一片冰晶。'冰心剑意——心要静，剑要冷。但心冷不是无情。'"
          },
          {
            "scene": "论道",
            "minAffection": 40,
            "text": "'剑道的尽头是什么？不是天下无敌——是有一个人，值得你为他出剑。'她说完立刻别过头。'……这不是我说的。'"
          },
          {
            "scene": "通用",
            "minAffection": 0,
            "text": "剑灵儿在剑冢中舞剑，剑光如雪。她没看你，但她的剑路明显比平时慢了半拍——在等你来看。"
          }
        ]
      },
      {
        "id": "mu_qinglan",
        
        "sceneImage":"assets/cards/events/scene_pool_sect_training.png",
        "name": "慕青岚",
        "title": "天枢道院·万卷楼",
        "personality": {
          "benevolence": 75,
          "proud": 40,
          "persistence": 50,
          "affection": 45,
          "courage": 30
        },
        "appearRealms": [
          "foundation",
          "golden",
          "nascent",
          "deity",
          "tribulation"
        ],
        "pathRestriction": "spell",
        "defaultEmotion": "平静",
        "defaultMindset": "执念",
        "defaultLocation": "天枢道院·万卷楼",
        "startAffection": 0,
        "startTrust": 0,
        "teachable": true,
        "firstMeeting": "她从古籍后面探出头，鼻尖上沾了一点灰。'万卷楼可不是谁都能进的。你有什么事？如果是闲逛——出门左转。'",
        "giftPrefs": {
          "love": [
            "古籍残卷",
            "稀有典籍"
          ],
          "like": [
            "灵石",
            "丹药材料",
            "灵茶"
          ],
          "hate": [
            "武器",
            "法器"
          ]
        },
        "secrets": [
          {
            "level": 1,
            "text": "慕青岚每天子时偷偷在万卷楼读《天道书》——虽然没人禁止但她还是心虚。"
          },
          {
            "level": 2,
            "text": "万卷楼《天道书》最后一页是空白的——上面本来有字，被'抹去'了。"
          },
          {
            "level": 3,
            "text": "她已经破译了最后一页的内容——不是被抹去的，是被'隐藏'了。那种隐藏手法——来自上界。这意味着飞升不是终点，而是某种选拔。"
          }
        ],
        "gossipTopics": [
          "天机阁的藏书和万卷楼的古籍——有些对不上。不是记错了，是有人动了手笔。",
          "玄机真人和白刃真人暗中见过三次面——她是从借书记录推算出来的。",
          "她在万卷楼最深处的暗格里找到了一本没有名字的日记——作者至少是三千年前的人。"
        ],
        "knownInfo": [
          {
            "text": "慕青岚读过万卷楼三分之二的藏书——她的修为不高，但见识不输长老。",
            "requiredAffection": 0
          },
          {
            "text": "她每天泡在万卷楼12个时辰——不是勤奋，是不喜欢和人打交道。",
            "requiredAffection": 30
          },
          {
            "text": "《天道书》最后一页的秘密她已经破译了一部分——但不敢告诉任何人。",
            "requiredAffection": 60
          },
          {
            "text": "她发现飞升是一个骗局。上界不是在迎接飞升者——是在筛选。",
            "requiredAffection": 80
          }
        ],
        "dialogues": [
          {
            "scene": "初见",
            "minAffection": 0,
            "text": "'你要找《通玄真经》第七卷？等一下——第七卷被前院的陈师弟借走了三个月还没还。（叹气）幸好我抄了一份。'"
          },
          {
            "scene": "闲聊",
            "minAffection": 30,
            "text": "'万卷楼里最奇怪的书？嗯……有一本没有名字的。打开全是空白。不是没写——是被'删掉'了。'"
          },
          {
            "scene": "修炼",
            "minAffection": 40,
            "text": "'根据《通玄真经》第七卷，你现在的修炼节奏错了。'她铺开一张纸，画了一条曲线。'看，你的灵气运转在这里拐弯了——应该走这条线。'"
          },
          {
            "scene": "论道",
            "minAffection": 50,
            "text": "'天道……你知道吗，万卷楼最深处的《天道书》最后一页是空白的。什么人能抹去天道书上的字？'"
          },
          {
            "scene": "请教",
            "minAffection": 20,
            "text": "慕青岚从书架上搬下来七本古籍，一本本翻给你看。'你看这一页、这一页、还有这一页——结合起来就是答案。'"
          },
          {
            "scene": "通用",
            "minAffection": 0,
            "text": "慕青岚埋在书堆后面，只能看到她的发髻和时不时翻页的手指。"
          }
        ]
      },
      {
        "id": "yin_xue",
        
        "sceneImage":"assets/cards/events/scene_pool_sect_training.png",
        "name": "殷血",
        "title": "血煞宗·第一天才",
        "personality": {
          "benevolence": 15,
          "proud": 90,
          "persistence": 85,
          "affection": 20,
          "courage": 95
        },
        "appearRealms": [
          "foundation",
          "golden",
          "nascent",
          "deity",
          "tribulation"
        ],
        "defaultEmotion": "平静",
        "defaultMindset": "执念",
        "defaultLocation": "西域·血煞绿洲",
        "startAffection": 0,
        "startTrust": 0,
        "teachable": true,
        "firstMeeting": "'你就是那个青云弟子？'他靠在枯树上，剑尖在石头上划出血槽。'听说你很能打。不过——正道教的那些花里胡哨的剑法，拿来杀鸡还行。'",
        "giftPrefs": {
          "love": [
            "好酒",
            "对手的剑"
          ],
          "like": [
            "疗伤丹药",
            "血属性材料"
          ],
          "hate": [
            "书",
            "佛经",
            "善因物品"
          ]
        },
        "secrets": [
          {
            "level": 1,
            "text": "殷血其实不嗜血——他的血魔功是被血煞老祖强行灌入的。不杀就会反噬自己。"
          },
          {
            "level": 2,
            "text": "他每次和你打完都偷偷吃了一颗回春丹——嘴上说三招，其实每次都在拼命。"
          },
          {
            "level": 3,
            "text": "他在找一件能切断血魔功传承的上古法宝。如果找到——他愿意洗去一身魔功，重新做人。"
          }
        ],
        "gossipTopics": [
          "血煞老祖最近在闭关——没人知道他在准备什么。但护法们都在扩建血池。",
          "魔道三宗里有不止一个正道卧底——殷血知道至少三个，但他一个都没揭发。",
          "西域荒漠深处有上古血魔的陵墓——血煞宗一直在找入口。找到了就是腥风血雨。"
        ],
        "knownInfo": [
          {
            "text": "殷血是血煞宗百年来唯一一个活着练成血魔功的弟子。",
            "requiredAffection": 0
          },
          {
            "text": "他其实很在意和你的比试结果——虽然嘴上从来不承认。",
            "requiredAffection": 30
          },
          {
            "text": "他的血魔功不是自己选的。是血煞老祖在他七岁时种下的——不杀就会死。",
            "requiredAffection": 60
          },
          {
            "text": "他在秘密寻找洗去魔功的方法。如果找到——他愿意放下血煞宗的一切。",
            "requiredAffection": 80
          }
        ],
        "dialogues": [
          {
            "scene": "初见",
            "minAffection": 0,
            "text": "'三招。你就这点本事？'他收了剑转身要走，走了几步又回头。'不过你的最后一剑……有点意思。下次找我——我随时有空。'"
          },
          {
            "scene": "闲聊",
            "minAffection": 30,
            "maxAffection": 60,
            "text": "'你又赢了。他妈的——你到底怎么练的？正道不应该都是废物吗？（顿了顿）算了，当我没说。喝酒。'"
          },
          {
            "scene": "闲聊",
            "minAffection": 70,
            "text": "'你知道我为什么杀人不眨眼吗？（喝了半壶）因为我见过的正道修士，没有一个手上干净的。我至少承认我杀了。'"
          },
          {
            "scene": "修炼",
            "minAffection": 40,
            "text": "'来，老地方。三招。'——这是他独特的'我很想你'。"
          },
          {
            "scene": "危机",
            "minAffection": 80,
            "text": "'（站在两军之间）你我为敌。今日若分生死……如果我活下来，你欠我一顿酒。'"
          },
          {
            "scene": "通用",
            "minAffection": 0,
            "text": "殷血用剑尖在地上划痕，一道接一道，不知道在想什么。"
          }
        ]
      },
      {
        "id": "jiuwei_suyue",
        
        "sceneImage":"assets/cards/events/scene_pool_sect_training.png",
        "name": "九尾溯月",
        "title": "九尾天狐·太古幸存者",
        "personality": {
          "benevolence": 50,
          "proud": 85,
          "persistence": 40,
          "affection": 60,
          "courage": 70
        },
        "appearRealms": [
          "golden",
          "nascent",
          "deity",
          "tribulation"
        ],
        "defaultEmotion": "平静",
        "defaultMindset": "执念",
        "defaultLocation": "南疆·月湖",
        "startAffection": 0,
        "startTrust": 0,
        "teachable": true,
        "firstMeeting": "'就是你救了我家那只小白狐？'她从月下走出来，九条白色的尾巴如瀑布般散落。'长得还行。就是修为太差了。'",
        "secrets": [
          {
            "level": 1,
            "text": "九尾在三千年前的满月之夜差点飞升——但在最后一刻回头了。"
          },
          {
            "level": 2,
            "text": "她是太古浩劫的亲眼见证者。妖族在那场浩劫中死了九成。"
          },
          {
            "level": 3,
            "text": "混沌之力是唯一能打破天道的东西。她一直在收集混沌碎片，已经找到了两块。"
          }
        ],
        "giftPrefs": {
          "love": [
            "太古遗物",
            "混沌碎片",
            "月下之花"
          ],
          "like": [
            "古物",
            "灵药",
            "丝织品"
          ],
          "hate": [
            "凡人物品",
            "普通灵石"
          ]
        },
        "dialogues": [
          {
            "scene": "初见",
            "minAffection": 0,
            "text": "'你每次遇到困难都不放弃。这点倒是跟我年轻时很像。不过——我年轻时吃了很多亏。'"
          },
          {
            "scene": "闲聊",
            "minAffection": 30,
            "text": "'那个时代……不提也罢。你知道太古浩劫死了多少妖族吗？你知道活下来的人心里是什么样的吗？'"
          },
          {
            "scene": "论道",
            "minAffection": 50,
            "text": "'因为我不飞升。飞升是骗局。'她第一次用认真的语气——'我三千年前就可以飞升了。但我在最后一刻回头看——看到了飞升的真相。所以我不去了。'"
          },
          {
            "scene": "修炼",
            "minAffection": 40,
            "text": "'三千年了，你是第一个让我笑的人。不是嘲笑——是真的……笑了。'"
          },
          {
            "scene": "危机",
            "minAffection": 80,
            "text": "'我已经孤单了三千年。如果你愿意……剩下的三千年，我想有人陪着。'她用手指在你额头上点了一下。'这不是狐族的魅术——是印记。'"
          },
          {
            "scene": "通用",
            "minAffection": 0,
            "text": "九尾溯月坐在月湖边，九条尾巴散落在身后。她在看月亮——但月亮已经看了她三千年。"
          }
        ]
      },
      {
        "id": "tianji_laoren",
        
        "sceneImage":"assets/cards/events/scene_pool_sect_training.png",
        "name": "天机老人",
        "title": "天机阁掌阁",
        "personality": {
