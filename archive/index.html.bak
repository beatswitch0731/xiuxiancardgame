            }
          }
        }
      },
      {
        "id": "iw_family_hostage",
        
        "sceneImage":"assets/cards/events/scene_pool_story_moment.png",
        "type": "SPECIAL",
        "title": "家人",
        "description": "魔道找到了你的软肋——你在凡间的家人。一封信送到了你的洞府：'你的母亲在万毒门做客——不是强迫的。但她想见你。'你手指发麻——不是因为魔气，是恐惧。",
        "realm": "golden",
        "weight": 5,
        "path": null,
        "tags": [
          "interweave",
          "demonic_mortal",
          "crisis"
        ],
        "requiresFlags": {
