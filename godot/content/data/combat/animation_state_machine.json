{
  "contractId": "combat_animation_state_machine_v1",
  "version": 1,
  "purpose": "战斗角色动画状态的单一权威源：每个状态的时长、缓动、进入条件、打断优先级与兜底超时。演出层（DeckCombatUI）与样式层（combat-controls.css）都从这里取值，任何一方不得自行硬编码时长或缓动。",
  "authorityNote": "durationMs 取自 data/combat/action_presentations.json 的 timelines 实测值，非估算。move 态是唯一没有已授权帧素材的状态，由舞台位移承载。",

  "globalRules": {
    "defaultReturn": "idle",
    "watchdogFormula": "durationMs * 2 + 800",
    "watchdogGraceMs": 800,
    "maxConcurrentPerActor": 1,
    "queuePolicy": "同角色新动作入队，不并发；队列在状态非 idle 时暂存，回到 idle 后按入队顺序消费",
    "interruptPolicy": "仅当新状态 interruptPriority 严格大于当前状态时才允许打断；相等或更低则入队",
    "reducedMotionPolicy": "prefers-reduced-motion 下走 reducedMotion 分支：位移与震屏归零，帧序列保留但时长按 reducedMotion.durationMs",
    "terminalStates": ["defeat", "victory"],
    "unknownStatePolicy": "未知状态一律回落 idle，不允许停在未定义状态"
  },

  "easingVocabulary": {
    "pixel_step": "steps(1, end)",
    "pixel_step_2": "steps(2, end)",
    "impact_out": "cubic-bezier(0.16, 0.84, 0.36, 1)",
    "settle_out": "cubic-bezier(0.22, 1, 0.28, 1)",
    "anticipate_in": "cubic-bezier(0.42, 0, 0.68, 0.32)",
    "linear_hold": "linear"
  },

  "states": [
    {
      "id": "idle",
      "label": "待机",
      "carrier": "frame_sequence",
      "timelineIds": [],
      "durationMs": 0,
      "easing": "linear_hold",
      "loop": true,
      "entryFrom": ["move", "attack", "skill", "guard", "hurt"],
      "exitTo": null,
      "interruptPriority": 0,
      "canInterruptBy": ["move", "attack", "skill", "guard", "hurt", "defeat"],
      "interruptRule": "待机是最低优先级，任何动作都可立即打断；被打断不产生回弹",
      "watchdogMs": 0,
      "fallbackTo": null,
      "reducedMotion": { "durationMs": 0, "easing": "linear_hold" },
      "notes": "待机是唯一可常驻的状态，不设看门狗（watchdogMs=0 表示禁用）"
    },
    {
      "id": "move",
      "label": "移动/位移",
      "carrier": "stage_transform",
      "timelineIds": [],
      "durationMs": 260,
      "easing": "settle_out",
      "loop": false,
      "entryFrom": ["idle"],
      "exitTo": "idle",
      "interruptPriority": 1,
      "canInterruptBy": ["attack", "skill", "guard", "hurt", "defeat"],
      "interruptRule": "位移中接到攻击/受击指令立即中断位移并从当前坐标起手，不做回退补间",
      "watchdogMs": 1320,
      "fallbackTo": "idle",
      "reducedMotion": { "durationMs": 0, "easing": "linear_hold" },
      "notes": "素材缺口：项目内暂无已授权的 move 帧序列，故由舞台 transform 承载；reducedMotion 下位移直接归零，角色瞬移到位"
    },
    {
      "id": "attack",
      "label": "攻击",
      "carrier": "frame_sequence",
      "timelineIds": ["player_attack_v1", "player_followthrough_v1", "player_point_thrust_v1", "player_probe_opening_v1"],
      "durationMs": 520,
      "easing": "pixel_step",
      "loop": false,
      "entryFrom": ["idle", "move"],
      "exitTo": "idle",
      "interruptPriority": 3,
      "canInterruptBy": ["hurt", "defeat"],
      "interruptRule": "命中帧（impactFrameIndex）之前不可被普通攻击打断，避免连击互相吃掉；只有受击与死亡可强断",
      "watchdogMs": 1840,
      "fallbackTo": "idle",
      "reducedMotion": { "durationMs": 260, "easing": "pixel_step" },
      "notes": "durationMs 取 player_attack_v1 实测 520；followthrough 650 / point_thrust 550 / probe_opening 520 为同族变体，取各自 timeline 的 duration 覆盖此默认值"
    },
    {
      "id": "skill",
      "label": "技能释放",
      "carrier": "frame_sequence",
      "timelineIds": ["player_skill_v1"],
      "durationMs": 600,
      "easing": "pixel_step",
      "loop": false,
      "entryFrom": ["idle", "move"],
      "exitTo": "idle",
      "interruptPriority": 4,
      "canInterruptBy": ["defeat"],
      "interruptRule": "技能优先级高于普通攻击，且释放过程中连受击也不打断（受击改为叠加受击特效而非切状态），只有死亡可强断",
      "watchdogMs": 2000,
      "fallbackTo": "idle",
      "reducedMotion": { "durationMs": 300, "easing": "pixel_step" },
      "notes": "durationMs 取 player_skill_v1 实测 600。释放期间受击以叠加层表现，避免技能被自己的受击打断导致演出断裂"
    },
    {
      "id": "guard",
      "label": "格挡/守势",
      "carrier": "frame_sequence",
      "timelineIds": ["player_guard_v1", "player_sheath_guard_v1"],
      "durationMs": 420,
      "easing": "pixel_step",
      "loop": false,
      "entryFrom": ["idle", "move", "attack"],
      "exitTo": "idle",
      "interruptPriority": 2,
      "canInterruptBy": ["attack", "skill", "hurt", "defeat"],
      "interruptRule": "守势可被任意主动作打断，保证玩家按键后立刻能反击，不产生'按了没反应'",
      "watchdogMs": 1640,
      "fallbackTo": "idle",
      "reducedMotion": { "durationMs": 220, "easing": "pixel_step" },
      "notes": "durationMs 取 player_guard_v1 实测 420；sheath_guard 变体 540"
    },
    {
      "id": "hurt",
      "label": "受击",
      "carrier": "frame_sequence",
      "timelineIds": ["hurt_v1"],
      "durationMs": 360,
      "easing": "pixel_step",
      "loop": false,
      "entryFrom": ["idle", "move", "attack", "guard"],
      "exitTo": "idle",
      "interruptPriority": 5,
      "canInterruptBy": ["hurt", "defeat"],
      "interruptRule": "受击可打断除技能外的所有状态；连续受击时后者覆盖前者并重置计时，不叠加排队（否则会出现受击回放卡顿）",
      "watchdogMs": 1520,
      "fallbackTo": "idle",
      "reducedMotion": { "durationMs": 200, "easing": "pixel_step" },
      "notes": "durationMs 取 hurt_v1 实测 360。连续受击覆盖而非排队，是为了避免伤害密集时出现长串受击回放"
    },
    {
      "id": "defeat",
      "label": "死亡",
      "carrier": "frame_sequence",
      "timelineIds": ["defeat_v1"],
      "durationMs": 760,
      "easing": "pixel_step",
      "loop": false,
      "entryFrom": ["idle", "move", "attack", "skill", "guard", "hurt"],
      "exitTo": null,
      "interruptPriority": 9,
      "canInterruptBy": [],
      "interruptRule": "终结态：不可被打断，播完即停；不回 idle",
      "watchdogMs": 2320,
      "fallbackTo": null,
      "reducedMotion": { "durationMs": 380, "easing": "pixel_step" },
      "notes": "durationMs 取 defeat_v1 实测 760。终结态的看门狗只用于清理残留 DOM，不做状态回落"
    },
    {
      "id": "victory",
      "label": "胜利",
      "carrier": "frame_sequence",
      "timelineIds": ["victory_v1"],
      "durationMs": 760,
      "easing": "pixel_step",
      "loop": false,
      "entryFrom": ["idle", "attack", "skill"],
      "exitTo": null,
      "interruptPriority": 8,
      "canInterruptBy": ["defeat"],
      "interruptRule": "终结态，与 defeat 互斥；只有 defeat 可覆盖（极端并发保护）",
      "watchdogMs": 2320,
      "fallbackTo": null,
      "reducedMotion": { "durationMs": 380, "easing": "pixel_step" },
      "notes": "durationMs 取 victory_v1 实测 760"
    }
  ],

  "transitionMatrix": {
    "idle": ["move", "attack", "skill", "guard", "hurt", "defeat"],
    "move": ["idle", "attack", "skill", "guard", "hurt", "defeat"],
    "attack": ["idle", "hurt", "defeat"],
    "skill": ["idle", "defeat"],
    "guard": ["idle", "attack", "skill", "hurt", "defeat"],
    "hurt": ["idle", "hurt", "defeat"],
    "defeat": [],
    "victory": ["defeat"]
  }
}
