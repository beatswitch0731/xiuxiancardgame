{
  "description": "三层位置体系 —— 主场景(T1) → 细粒度位置(T2) → 隐藏位置(T3)。包含场景卡牌池。",
  "locations": {
    "宗门": {
      "name": "青云剑宗",
      "tier": 1,
      "atmosphere": { "bgClass": "loc-sect", "borderColor": "#c9a96e", "particleType": "cloud", "description": "云雾缭绕，剑鸣清越" },
      "subLocations": ["宗门大殿", "藏经阁", "炼丹房", "后山竹林", "剑崖", "裂石山径"],
      "description": "青云剑宗——天下剑修的圣地。巍峨殿宇依山而建，灵气如瀑，从万仞绝壁上倾泻。空气中弥漫着剑气、丹香和千年古木的气息。",
      "music": "serene"
    },
    "裂石山径": {
      "name": "山门外·裂石山径",
      "tier": 2,
      "parent": "宗门",
      "atmosphere": {
        "bgClass": "loc-sect",
        "borderColor": "#94a7ae",
        "particleType": "mist",
        "description": "雨后碎石间有极淡的灵压游移，山门已隐入远雾。"
      },
      "description": "宗门外的旧山路。路标裂开，湿石上留下两道未干的剑痕。",
      "music": "serene"
    },
    "坊市": {
      "name": "修仙坊市",
      "tier": 1,
      "atmosphere": { "bgClass": "loc-market", "borderColor": "#d4443b", "particleType": "spark", "description": "人声鼎沸，灵石流转" },
      "subLocations": ["坊市中心", "万宝楼", "天机阁", "铁匠铺", "灵草街"],
      "description": "修士聚集的交易之所。叫卖声、讨价还价声、剑气碰撞声此起彼伏。铜钱纹的灯笼下，灵石的光芒照亮了各怀心思的脸。",
      "music": "bustling"
    },
    "秘境": {
      "name": "上古秘境",
      "tier": 1,
      "atmosphere": { "bgClass": "loc-dungeon", "borderColor": "#5b7fff", "particleType": "rune", "description": "符文流转，危机暗藏" },
      "subLocations": ["秘境入口", "试炼通道", "灵脉矿洞", "古修洞府"],
      "description": "上古大能留下的试炼之地。石壁上刻着失传的功法，地底深处埋着从未有人触碰过的宝物——还有从未有人活着离开的陷阱。",
      "music": "mysterious"
    },
    "洞府": {
      "name": "修士洞府",
      "tier": 1,
      "atmosphere": { "bgClass": "loc-cave", "borderColor": "#4a7c59", "particleType": "mist", "description": "幽静冥想，灵雾弥漫" },
      "subLocations": ["炼气室", "丹房", "剑室", "灵兽棚"],
      "description": "你的私人修炼之所。石壁上爬满了灵藤，泉水潺潺，月华透过洞顶的天然裂缝洒下。这里每一寸空气都浸透了你的气息。",
      "music": "peaceful"
    },
    "魔域": {
      "name": "血煞魔域",
      "tier": 1,
      "atmosphere": { "bgClass": "loc-demon", "borderColor": "#7b2d3b", "particleType": "ember", "description": "魔气弥漫，压抑邪异" },
      "subLocations": ["魔域外城", "血煞宫", "魔泉", "白骨荒野"],
      "description": "人间与魔界的夹缝——正道修士提起此地都会皱眉。黑色岩石上流淌着暗红色的魔泉，空气中弥漫着铁锈和檀香混合的奇异气味。",
      "music": "ominous"
    },
    "天道虚空": {
      "name": "天道虚空",
      "tier": 1,
      "atmosphere": { "bgClass": "loc-void", "borderColor": "transparent", "particleType": "star", "description": "无尽虚空，直面天道" },
      "subLocations": ["天道裂缝", "因果之海", "时间回廊"],
      "description": "飞升的前一站——虚无中没有上下左右，只有星辰般的因果之线从你身上延伸出去，连接着每一个被你影响的人。天道的轰鸣在头颅内回响。",
      "music": "transcendent"
    },
    "武盟雷峰": {
      "name": "武盟雷峰",
      "tier": 1,
      "atmosphere": { "bgClass": "loc-wumeng", "borderColor": "#8096b5", "particleType": "mist", "description": "瀑雾压阶，雷峰在云后低鸣" },
      "subLocations": ["淬体山道", "镇关石台", "万钧瀑布", "天雷峰"],
      "description": "武盟雷峰的石阶贴着瀑壁向上，雨水沿每一道拳痕汇入台下。这里不把来者分成剑、法、体或丹，只看他在压力真正落下时怎样站住。",
      "music": "thunder_pass"
    },
    "剑崖": {
      "name": "剑崖",
      "tier": 2,
      "parent": "宗门",
      "atmosphere": { "bgClass": "loc-sect", "borderColor": "#8eb8d0", "particleType": "spark", "description": "剑气纵横，铁锈味的微风" },
      "tier1_desc": "万仞绝壁，剑气纵横千年留下的痕迹如蛛网密布。风吹过时，崖壁发出低沉的呜咽——据说那是历代在此悟道的剑修残魂。",
      "tier2_desc": "你注意到崖壁最底部的剑痕与其他不同——不是劈砍，而是「写」。有人在崖壁上，用剑刻下了一整篇……情书？落款处没有名字，只有一个「白」字。",
      "transitionFlags": {
        "bai_ren_departed": "剑气消散，崖壁开始风化。那只「白」字的情书，现在读来，字字如泪。白刃真人的剑意已经离开这片绝壁——就像他离开了这个人间。"
      }
    },
    "qingyun_sword_tomb": {
      "name": "青云剑冢",
      "tier": 2,
      "parent": "宗门",
      "atmosphere": { "bgClass": "loc-sect", "borderColor": "#8aa5b8", "particleType": "mist", "description": "残剑成林，暮雾压低每一道剑鸣" },
      "description": "青云后山的旧剑冢。历代折损的剑被依序立入黑石，石缝间只有薄苔与未散的剑意；白刃把最后一课约在这里，不是为了怀旧，而是让后来者看见每一条未走完的剑路。",
      "music": "sword_tomb_dusk"
    },
    "deity_market_stone_street": {
      "name": "化神坊市 · 石街",
      "tier": 2,
      "parent": "坊市",
      "atmosphere": { "bgClass": "loc-market", "borderColor": "#c18b52", "particleType": "spark", "description": "石灯低悬，旧器余灵在摊位间窃语" },
      "description": "化神修士交易旧器的长街。铺面不吆喝，只在石灯下摆出仍有余灵的器物；每一道报价都同时衡量灵石、人情与因果。",
      "music": "market_stone_street"
    },
    "qingyun_trial_sword_terrace": {
      "name": "青云试剑台",
      "tier": 2,
      "parent": "宗门",
      "atmosphere": { "bgClass": "loc-sect", "borderColor": "#9aa9bd", "particleType": "spark", "description": "封剑印环台而立，旧剑只认招式与承诺" },
      "description": "宗门封存试锋剑的石台。三重封剑印沿台阶环绕，借出的每一柄旧剑都会记录来者如何出剑、为何出剑，以及是否按时归还。",
      "music": "trial_sword_terrace"
    },
    "upper_realm_heaven_gate": {
      "name": "天门前庭",
      "tier": 3,
      "parent": "天道虚空",
      "atmosphere": { "bgClass": "loc-void", "borderColor": "#d8c9a6", "particleType": "star", "description": "雷云止于门槛，门后没有风声" },
      "description": "上下两界交叠的一线门庭。门外仍有雷声、石屑与人的呼吸，门内却像把一切声响都抽走；飞升者踏过门槛后，肉身气息便不会再回到下界。",
      "music": "heaven_gate_farewell"
    }
  },

