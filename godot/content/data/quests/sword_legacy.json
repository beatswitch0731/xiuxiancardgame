      "title": "剑冢遗音",
      "sceneImage": "assets/cards/keyframes/scene_key_sword_legacy_rust_echo_v1.png",
      "artDirection": { "presentation": "scene", "keyframe": true, "chapter": "剑冢遗承", "alt": "剑冢中一柄锈剑初次震鸣，白刃和主角尚未触碰剑柄。" },
      "description": "青云剑宗深处——一处被遗忘的剑冢。你路过时，一柄生锈的古剑轻轻震鸣。白刃真人停下脚步：'它三百年没响过了。它在对你说话。'\n\n剑身上刻着一行模糊的小字：'持剑者知道剑的重量——不是铁的重量，是心的重量。'",
      "type": "QUEST",
      "questId": "sword_legacy",
      "questStep": 1,
      "realm": "foundation",
      "weight": 0,
      "choices": {
        "left": {
