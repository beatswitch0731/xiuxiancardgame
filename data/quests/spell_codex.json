        "right": {
          "text": "接受契约",
          "effects": { "cultivation": 15, "daoHeart": -1, "karmaBad": 2, "spell_insight": 1, "_setFlag": "spell_codex_contract_accepted" },
          "questNext": "q_spell_4",
          "karmaSeed": [
            { "id": "spellCodexContract", "delay": 6, "realm": "nascent", "priority": 3 }
          ]
        }
      }
